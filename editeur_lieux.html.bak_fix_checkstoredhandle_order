//  HISTORIQUE (UNDO)
// ══════════════════════════════════════════════════════════
var _history = [];
var HISTORY_MAX = 20;

function pushHistory(){
  _history.push({
    pois: JSON.parse(JSON.stringify(POIS)),
    zones: JSON.parse(JSON.stringify(ZONES))
  });
  if(_history.length > HISTORY_MAX) _history.shift();
  var btn = document.getElementById('btn-undo');
  if(btn) btn.disabled = false;
}

function undoState(){
  if(_history.length === 0) return;
  var snap = _history.pop();
  POIS.length = 0;
  snap.pois.forEach(function(p){ POIS.push(p); });
  ZONES.length = 0;
  snap.zones.forEach(function(z){ ZONES.push(z); });
  var maxId = 0;
  POIS.forEach(function(p){ if(p.id > maxId) maxId = p.id; });
  nextId = maxId + 1;
  // Reconstruire les marqueurs
  Object.keys(markers).forEach(function(id){ map.removeLayer(markers[id]); });
  markers = {};
  buildMarkers();
  rebuildZoneSelects();
  applyFilters();
  renderRouteList();
  // Si un POI était sélectionné, vérifier qu'il existe encore
  if(selectedId && !POIS.find(function(p){ return p.id===selectedId; })){
    selectedId = null;
    document.getElementById('edit-panel').classList.add('hidden');
  }
  saveState();
  showToast('↩ Modification annulée');
  var btn = document.getElementById('btn-undo');
  if(btn) btn.disabled = (_history.length === 0);
}

//  PERSISTANCE LOCALE (localStorage)
// ══════════════════════════════════════════════════════════
var POIS_STORE_KEY = 'nougaterie_pois_v1';
var _pendingSave   = null;
var _savedData     = null; // snapshot avant restauration éventuelle

function saveState(){
  clearTimeout(_pendingSave);
  _pendingSave = setTimeout(function(){
    try {
      var payload = {
        pois: POIS,
        zones: ZONES,
        ts: new Date().toISOString(),
        count: POIS.length
      };
      localStorage.setItem(POIS_STORE_KEY, JSON.stringify(payload));
      var ind = document.getElementById('save-indicator');
      if(ind){
        var d = new Date();
        var hm = ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);
        ind.textContent = '💾 ' + hm;
        ind.className = 'saved';
      }
    } catch(e){ console.warn('saveState error', e); }
  }, 600); // debounce 600ms
}

function markUnsaved(){
  var ind = document.getElementById('save-indicator');
  if(ind){ ind.textContent = '💾 non sauvegardé'; ind.className = 'unsaved'; }
}

function restoreState(){
  try {
    var raw = localStorage.getItem(POIS_STORE_KEY);
    if(!raw) return false;
    var data = JSON.parse(raw);
    if(!data || !data.pois || data.pois.length === 0) return false;
    _savedData = data;
    var d = new Date(data.ts);
    var dateStr = d.toLocaleDateString('fr-FR') + ' à ' + ('0'+d.getHours()).slice(-2) + ':' + ('0'+d.getMinutes()).slice(-2);
    document.getElementById('restore-msg').textContent =
      '📂 ' + data.count + ' lieux sauvegardés le ' + dateStr + ' – voulez-vous restaurer vos modifications ?';
    document.getElementById('restore-banner').classList.remove('hidden');
    return true;
  } catch(e){ return false; }
}

function applyRestore(){
  if(!_savedData) return;
  POIS.length = 0;
  _savedData.pois.forEach(function(p){ POIS.push(p); });
  if(_savedData.zones && _savedData.zones.length > 0){
    ZONES.length = 0;
    _savedData.zones.forEach(function(z){ ZONES.push(z); });
  }
  var maxId = 0;
  POIS.forEach(function(p){ if(p.id > maxId) maxId = p.id; });
  nextId = maxId + 1;
  document.getElementById('restore-banner').classList.add('hidden');
  Object.keys(markers).forEach(function(id){ map.removeLayer(markers[id]); });
  markers = {};
  buildMarkers();
  rebuildZoneSelects();
  applyFilters();
  var ind = document.getElementById('save-indicator');
  if(ind){ ind.textContent = '💾 restauré'; ind.className = 'saved'; }
  showToast('✓ ' + POIS.length + ' lieux restaurés depuis la dernière session');
}

function dismissRestore(){
  _savedData = null;
  document.getElementById('restore-banner').classList.add('hidden');
  localStorage.removeItem(POIS_STORE_KEY);
  var ind = document.getElementById('save-indicator');
  if(ind){ ind.textContent = '💾 non sauvegardé'; ind.className = 'unsaved'; }
}

function resetToOriginal(){
  if(!confirm('Effacer toutes les modifications locales et revenir aux données du fichier CSV d\'origine ?')) return;
  localStorage.removeItem(POIS_STORE_KEY);
  location.reload();
}

(function(){
  var handle = document.getElementById('tournee-resize-handle');
  var panel = document.getElementById('tournee-panel');
  if(!handle || !panel) return;
  var dragging = false;
  function resizeTo(clientY){
    var rect = panel.getBoundingClientRect();
    var newHeight = rect.bottom - clientY;
    newHeight = Math.max(280, Math.min(newHeight, window.innerHeight - 20));
    panel.style.maxHeight = newHeight + 'px';
  }
  handle.addEventListener('mousedown', function(e){ dragging = true; e.preventDefault(); document.body.style.userSelect = 'none'; });
  document.addEventListener('mousemove', function(e){ if(dragging) resizeTo(e.clientY); });
  document.addEventListener('mouseup', function(){ dragging = false; document.body.style.userSelect = ''; });
  handle.addEventListener('touchstart', function(){ dragging = true; }, {passive:true});
  document.addEventListener('touchmove', function(e){ if(dragging && e.touches[0]) resizeTo(e.touches[0].clientY); }, {passive:true});
  document.addEventListener('touchend', function(){ dragging = false; });
})();

buildMarkers();
applyFilters();
restoreState();
checkStoredHandle();
(function(){
  var params = new URLSearchParams(window.location.search);
  var editId = params.get('edit_tournee');
  if(editId) loadTourneeForEdit(parseInt(editId,10));
})();
(function(){
  var ind = document.getElementById('save-indicator');
  if(ind && !localStorage.getItem(POIS_STORE_KEY)){
    ind.textContent = '💾 non sauvegardé'; ind.className = '';
  }
})();
