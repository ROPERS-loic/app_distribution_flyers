async function loadSaisonsActuelles(){
  try{
    var rows = await sbGet('saisons_lieux?select=lieu_id,annee,date_ouverture,date_fermeture&order=lieu_id.asc,annee.desc');
    var map = {};
    rows.forEach(function(r){ if(!map[r.lieu_id]) map[r.lieu_id] = r; });
    saisonsMap = map;
    saisonsLoaded = true;
  } catch(e){ saisonsMap = {}; }
}
function saisonStatut(lieuId){
  var s = saisonsMap[lieuId];
  if(!s || (!s.date_ouverture && !s.date_fermeture)) return null;
  var today = new Date().toISOString().slice(0,10);
  if(s.date_fermeture && today > s.date_fermeture && (!s.date_ouverture || today < s.date_ouverture)) return 'ferme';
  if(s.date_fermeture){
    var joursAvant = (new Date(s.date_fermeture) - new Date(today)) / 86400000;
    if(joursAvant >= 0 && joursAvant <= 30) return 'ferme_bientot';
  }
  return 'ouvert';
}
function poiSaisonRing(p){
  if(!saisonsAffichage || !p.supabase_id) return false;
  var st = saisonStatut(p.supabase_id);
  return st === 'ferme' || st === 'ferme_bientot';
}
function matchMoisSaison(p){
  var mois = document.getElementById('filter-mois-saison')?document.getElementById('filter-mois-saison').value:'';
  if(!mois) return true;
  if(!p.supabase_id) return false;
  var s = saisonsMap[p.supabase_id];
  if(!s || (!s.date_ouverture && !s.date_fermeture)) return false;
  var annee = s.annee || new Date().getFullYear();
  var mm = String(parseInt(mois,10)).padStart(2,'0');
  var monthStart = annee + '-' + mm + '-01';
  var monthEnd = annee + '-' + mm + '-31';
  var ouv = s.date_ouverture || (annee + '-01-01');
  var fer = s.date_fermeture || (annee + '-12-31');
  return ouv <= monthEnd && fer >= monthStart;
}
function updateMarkersVisibility(){
  if(!map) return;
  POIS.forEach(function(p){
