async function sbLogin(){
  var email = document.getElementById('sb-email').value.trim();
  var pwd   = document.getElementById('sb-pwd').value;
  var err   = document.getElementById('sb-login-err');
  err.style.display = 'none';
  try {
    var data = await sbAuthPost('token?grant_type=password', {email: email, password: pwd});
    localStorage.setItem('sb-krbzipnoeroaofojccri-auth-token', JSON.stringify(data));
    hideSbLogin(); autoSyncSupabase();
  } catch(e){ err.textContent = e.message; err.style.display = 'block'; }
}


async function syncSupabase(){
  var stored = getStoredSession();
  if(!stored || !stored.user){ showSbLogin(); showToast('⚠ Connecte-toi d\'abord pour synchroniser Supabase'); return; }

  showToast('☁️ Sync Supabase…');
  var existing = await sbGet('lieux?select=id,nom').catch(function(){return[];});
  var byNom = {};
  (existing||[]).forEach(function(l){ byNom[(l.nom||'').toLowerCase().trim()] = l; });

  var toInsert = [], toUpdate = [];
  POIS.forEach(function(p){
    var data = {
      nom:          p.nom||'',
      categorie:    p.type_lieu||'',
      adresse:      p.adresse||'',
      code_postal:  p.code_postal||'',
      ville:        p.commune||'',
      latitude:     parseFloat(p.lat)||null,
      longitude:    parseFloat(p.lon)||null,
      telephone:    p.contacts||'',
      zone_tournee: p.zone_tournee||'',
      notes:        p.description||'',
      actif:        p.statut !== 'closed_perm'
    };
    var key = (p.nom||'').toLowerCase().trim();
    if(byNom[key]){ toUpdate.push({ id: byNom[key].id, data }); }
    else { toInsert.push(data); }
  });

  var errors = 0;
  // Insertions par lots
  for(var i=0; i<toInsert.length; i+=50){
    try { await sbPost('lieux', toInsert.slice(i, i+50)); }
    catch(e){ errors++; console.error('insert', e.message); }
  }
  // Mises à jour par lots de 1
  for(var j=0; j<toUpdate.length; j++){
    try { await sbPatch('lieux', 'id=eq.'+toUpdate[j].id, toUpdate[j].data); }
    catch(e){ errors++; console.error('update', toUpdate[j].data.nom, e.message); }
  }

  if(errors){ showToast('⚠ Sync terminée avec ' + errors + ' erreur(s)'); }
  else { showToast('✅ Supabase synchronisé — ' + toInsert.length + ' insérés · ' + toUpdate.length + ' mis à jour'); }
}

