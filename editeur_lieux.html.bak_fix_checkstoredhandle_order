    list.innerHTML = '<div id="tournee-empty">Cliquez sur des lieux pour les ajouter</div>';
    renderDepartArriveeSelects();
    return;
  }
  list.innerHTML = '';
  var dragSrcIdx = null;
  tourneeStops.forEach(function(id, i){
    var p = POIS.find(function(p){ return p.id===id; }); if(!p) return;
    var hasLivraison = !!tourneeStopTypes[id];
    var div = document.createElement('div');
    div.className = 'tournee-stop'+(hasLivraison?' is-livraison':''); div.draggable = true; div.dataset.idx = i;
    div.innerHTML = '<span class="tournee-drag">⠿</span>'
      + '<div class="tournee-stop-num">'+(i+1)+'</div>'
      + '<div class="tournee-stop-info"><div class="tournee-stop-nom">'+escHtml(p.nom)+'</div>'
      + '<div class="tournee-stop-sub">'+escHtml(p.commune)+' · '+escHtml(p.zone_tournee?p.zone_tournee.split(' ')[0]:'')+'</div>'
      + (hasLivraison ? '<div class="tournee-stop-desc">📦 '+escHtml(tourneeStopLivraisonDesc[id]||'(à préciser)')+'</div>' : '')
      + '</div>'
      + '<span class="tournee-stop-livraison-btn'+(hasLivraison?' active':'')+'" onclick="toggleLivraisonType('+id+')" title="Ajouter/retirer une livraison sur cet arrêt">📦</span>'
      + '<span class="tournee-stop-del" onclick="removeTourneeStop('+i+')">✕</span>';
    div.addEventListener('dragstart', function(e){
      dragSrcIdx = i; e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', String(i));
      setTimeout(function(){ div.classList.add('dragging'); }, 0);
    });
    div.addEventListener('dragend', function(){
      div.classList.remove('dragging');
      list.querySelectorAll('.tournee-stop').forEach(function(el){ el.classList.remove('drag-over'); });
    });
    div.addEventListener('dragover', function(e){
      e.preventDefault(); e.dataTransfer.dropEffect = 'move';
      list.querySelectorAll('.tournee-stop').forEach(function(el){ el.classList.remove('drag-over'); });
      if(i !== dragSrcIdx) div.classList.add('drag-over');
    });
    div.addEventListener('dragleave', function(){ div.classList.remove('drag-over'); });
    div.addEventListener('drop', function(e){
      e.preventDefault(); div.classList.remove('drag-over');
      var from = parseInt(e.dataTransfer.getData('text/plain'));
      if(isNaN(from) || from === i) return;
      var moved = tourneeStops.splice(from, 1)[0];
      tourneeStops.splice(i, 0, moved);
      POIS.forEach(function(p){ refreshMarkerIcon(p.id); });
      renderList(); renderTourneeList(); clearTourneeLayer();
      showToast('↕ Ordre mis à jour');
    });
    list.appendChild(div);
  });
  renderDepartArriveeSelects();
}
