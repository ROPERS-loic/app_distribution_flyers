async function calcTournee(){
  if(tourneeStops.length < 2){ showToast('⚠ Ajoutez au moins 2 lieux'); return; }
  var wps = tourneeStops.map(function(id){
    var p = POIS.find(function(p){ return p.id===id; });
    return p ? [parseFloat(p.lat), parseFloat(p.lon)] : null;
  }).filter(function(w){ return w && !isNaN(w[0]); });
  var departValCalc = document.getElementById('tf-depart') ? document.getElementById('tf-depart').value : '';
  var arriveeValCalc = document.getElementById('tf-arrivee') ? document.getElementById('tf-arrivee').value : '';
  if(departValCalc && arriveeValCalc && departValCalc===arriveeValCalc){
    var loopP = POIS.find(function(p){ return p.id===parseInt(departValCalc,10); });
    if(loopP && !isNaN(parseFloat(loopP.lat))) wps.push([parseFloat(loopP.lat), parseFloat(loopP.lon)]);
  }
  if(wps.length < 2){ showToast('⚠ Coordonnées manquantes'); return; }
  showToast('⏳ Calcul…'); clearTourneeLayer();
  var allCoords = [], totalDist = 0, totalDur = 0, MAX = 25;
  for(var s = 0; s < wps.length-1; s += MAX-1){
    var batch = wps.slice(s, Math.min(s+MAX, wps.length));
    var qs = batch.map(function(c){ return c[1]+','+c[0]; }).join(';');
    try {
      var r = await fetch('https://router.project-osrm.org/route/v1/driving/'+qs+'?overview=full&geometries=geojson');
      var d = await r.json();
      if(d.routes&&d.routes[0]){ totalDist+=d.routes[0].distance; totalDur+=d.routes[0].duration; d.routes[0].geometry.coordinates.forEach(function(c){ allCoords.push([c[1],c[0]]); }); }
    } catch(e){ break; }
  }
  if(allCoords.length > 0){
    tourneeRouteLayer = L.polyline(allCoords, {color:'#27AE60', weight:4, opacity:.85}).addTo(map);
    map.fitBounds(tourneeRouteLayer.getBounds(), {padding:[30,30]});
  }
  var km = (totalDist/1000).toFixed(1), h = Math.floor(totalDur/3600), m = Math.round((totalDur%3600)/60);
  var durStr = h>0 ? h+'h '+m+'min' : m+' min';
  document.getElementById('tournee-result-main').textContent = km+' km · '+durStr;
  document.getElementById('tournee-result-sub').textContent = tourneeStops.length+' arrêts';
  document.getElementById('tournee-result').style.display = 'block';
  showToast('✓ '+km+' km – '+durStr);
}

function optimizeTournee(){
  if(tourneeStops.length < 3){ showToast('⚠ Minimum 3 lieux'); return; }
  var departVal = document.getElementById('tf-depart') ? document.getElementById('tf-depart').value : '';
  var arriveeVal = document.getElementById('tf-arrivee') ? document.getElementById('tf-arrivee').value : '';
  var startId = departVal ? parseInt(departVal,10) : tourneeStops[0];
  var endId = arriveeVal ? parseInt(arriveeVal,10) : null;
  var rem = tourneeStops.filter(function(id){ return id!==startId && id!==endId; });
  var ordered = [startId], curId = startId;
  while(rem.length > 0){
    var curP = POIS.find(function(p){ return p.id===curId; }); if(!curP) break;
    var best = null, bestD = Infinity;
    rem.forEach(function(id){
      var p = POIS.find(function(p){ return p.id===id; }); if(!p) return;
      var d = haversine(parseFloat(curP.lat), parseFloat(curP.lon), parseFloat(p.lat), parseFloat(p.lon));
      if(d < bestD){ bestD = d; best = id; }
    });
    if(!best) break;
    ordered.push(best); rem.splice(rem.indexOf(best), 1); curId = best;
  }
  if(endId && endId!==startId) ordered.push(endId);
  tourneeStops = ordered;
  POIS.forEach(function(p){ refreshMarkerIcon(p.id); });
  renderList(); renderTourneeList(); clearTourneeLayer();
  document.getElementById('tournee-result').style.display = 'none';
  showToast('⚡ Optimisé ('+ordered.length+' arrêts)');
  calcTournee();
}

