function toggleRouteMode(){
  routeMode=!routeMode;
  var btn=document.getElementById('btn-route');
  btn.textContent=routeMode?'✕ Itinéraire':'📍 Itinéraire';
  btn.classList.toggle('active',routeMode);
  document.getElementById('route-panel').classList.toggle('open',routeMode);
  if(!routeMode) clearRouteLayer();
}
function toggleRouteStop(id){
  // Always add – same stop can appear twice (e.g. depart = arrivée)
  var p=POIS.find(function(p){return p.id===id;});
  routeStops.push(id);
  showToast('✓ Ajouté : '+(p?p.nom:''));
  POIS.forEach(function(p){refreshMarkerIcon(p.id);});
  renderList(); renderRouteList(); clearRouteLayer();
  document.getElementById('route-result').style.display='none';
  document.getElementById('gmap-row').style.display='none';
}
function removeRouteStop(idx){
  routeStops.splice(idx,1);
  POIS.forEach(function(p){refreshMarkerIcon(p.id);});
  renderList(); renderRouteList(); clearRouteLayer();
  document.getElementById('route-result').style.display='none';
  document.getElementById('gmap-row').style.display='none';
  showToast('✕ Étape retirée');
}
function renderRouteList(){
  var list=document.getElementById('route-list');
  if(routeStops.length===0){ list.innerHTML='<div id="route-empty">Cliquez sur des lieux pour les ajouter</div>'; return; }
  list.innerHTML='';
  var dragSrcIdx=null;
  routeStops.forEach(function(id,i){
    var p=POIS.find(function(p){return p.id===id;}); if(!p) return;
    var div=document.createElement('div');
    div.className='route-stop';
    div.draggable=true;
    div.dataset.idx=i;
    div.innerHTML='<span class="route-drag" title="Glisser pour réordonner">⠿</span>'
      +'<div class="route-stop-num">'+(i+1)+'</div>'
      +'<div class="route-stop-info"><div class="route-stop-nom">'+escHtml(p.nom)+'</div><div class="route-stop-sub">'+escHtml(p.commune)+' · '+escHtml(zoneKey(p.zone_tournee))+'</div></div>'
      +'<span class="route-stop-del" onclick="removeRouteStop('+i+')">✕</span>';
    div.addEventListener('dragstart',function(e){
      dragSrcIdx=i;
      e.dataTransfer.effectAllowed='move';
      e.dataTransfer.setData('text/plain',String(i));
      setTimeout(function(){div.classList.add('dragging');},0);
    });
    div.addEventListener('dragend',function(){
      div.classList.remove('dragging');
      list.querySelectorAll('.route-stop').forEach(function(el){el.classList.remove('drag-over');});
    });
    div.addEventListener('dragover',function(e){
      e.preventDefault();
      e.dataTransfer.dropEffect='move';
      list.querySelectorAll('.route-stop').forEach(function(el){el.classList.remove('drag-over');});
      if(i!==dragSrcIdx) div.classList.add('drag-over');
    });
    div.addEventListener('dragleave',function(){
      div.classList.remove('drag-over');
    });
    div.addEventListener('drop',function(e){
      e.preventDefault();
      div.classList.remove('drag-over');
      var fromIdx=parseInt(e.dataTransfer.getData('text/plain'));
      var toIdx=i;
      if(isNaN(fromIdx)||fromIdx===toIdx) return;
      var moved=routeStops.splice(fromIdx,1)[0];
      routeStops.splice(toIdx,0,moved);
      POIS.forEach(function(p){refreshMarkerIcon(p.id);});
      renderList(); renderRouteList(); clearRouteLayer();
      document.getElementById('route-result').style.display='none';
      document.getElementById('gmap-row').style.display='none';
      showToast('↕ Ordre mis à jour');
    });
    list.appendChild(div);
  });
}

async function calcRoute(){
  if(routeStops.length<2){showToast('⚠ Sélectionnez au moins 2 lieux');return;}
  var wps=routeStops.map(function(id){ var p=POIS.find(function(p){return p.id===id;}); return p?[parseFloat(p.lat),parseFloat(p.lon)]:null; }).filter(function(w){return w&&!isNaN(w[0]);});
  if(wps.length<2){showToast('⚠ Coordonnées manquantes');return;}
  showToast('⏳ Calcul…'); clearRouteLayer();
  var allCoords=[],totalDist=0,totalDur=0,MAX=25;
  for(var s=0;s<wps.length-1;s+=MAX-1){
    var batch=wps.slice(s,Math.min(s+MAX,wps.length));
    var qs=batch.map(function(c){return c[1]+','+c[0];}).join(';');
    try{
      var r=await fetch('https://router.project-osrm.org/route/v1/driving/'+qs+'?overview=full&geometries=geojson');
      var d=await r.json();
      if(d.routes&&d.routes[0]){ totalDist+=d.routes[0].distance; totalDur+=d.routes[0].duration; d.routes[0].geometry.coordinates.forEach(function(c){allCoords.push([c[1],c[0]]);});}
    }catch(e){showToast('⚠ OSRM inaccessible – tracé direct');break;}
  }
  if(allCoords.length>0){ routeLayer=L.polyline(allCoords,{color:'#1E88E5',weight:4,opacity:.85}).addTo(map); map.fitBounds(routeLayer.getBounds(),{padding:[30,30]}); }
  else { routeLayer=L.polyline(wps,{color:'#1E88E5',weight:3,opacity:.5,dashArray:'8,6'}).addTo(map); map.fitBounds(routeLayer.getBounds(),{padding:[30,30]}); }
  var km=(totalDist/1000).toFixed(1),h=Math.floor(totalDur/3600),m=Math.round((totalDur%3600)/60);
  var durStr=h>0?h+'h '+m+'min':m+' min';
  document.getElementById('result-main').textContent=km+' km · '+durStr;
  document.getElementById('result-sub').textContent=routeStops.length+' arrêts · temps de trajet estimé';
  document.getElementById('route-result').style.display='block';
  document.getElementById('gmap-row').style.display='flex';
  showToast('✓ '+km+' km – '+durStr);
}

function optimizeRoute(){
  if(routeStops.length<3){showToast('⚠ Minimum 3 lieux');return;}
  var rem=routeStops.slice(1),ordered=[routeStops[0]],curId=routeStops[0];
  while(rem.length>0){
    var curP=POIS.find(function(p){return p.id===curId;}); if(!curP) break;
    var best=null,bestD=Infinity;
    rem.forEach(function(id){ var p=POIS.find(function(p){return p.id===id;}); if(!p) return; var d=haversine(parseFloat(curP.lat),parseFloat(curP.lon),parseFloat(p.lat),parseFloat(p.lon)); if(d<bestD){bestD=d;best=id;} });
    if(!best) break;
    ordered.push(best); rem.splice(rem.indexOf(best),1); curId=best;
  }
  routeStops=ordered;
  POIS.forEach(function(p){refreshMarkerIcon(p.id);}); renderList(); renderRouteList(); clearRouteLayer();
  document.getElementById('route-result').style.display='none';
  document.getElementById('gmap-row').style.display='none';
  showToast('⚡ Optimisé ('+ordered.length+' arrêts)');
  calcRoute();
}
function clearRoute(){
  routeStops=[]; clearRouteLayer();
  POIS.forEach(function(p){refreshMarkerIcon(p.id);}); renderList(); renderRouteList();
  document.getElementById('route-result').style.display='none';
  document.getElementById('gmap-row').style.display='none';
}
function clearRouteLayer(){ if(routeLayer){map.removeLayer(routeLayer);routeLayer=null;} }

