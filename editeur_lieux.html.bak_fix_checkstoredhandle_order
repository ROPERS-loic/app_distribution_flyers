  var ptsToLoad = isBoucle ? pts.slice(0, pts.length-1) : (pts||[]);
  ptsToLoad.forEach(function(pt){
    var p = POIS.find(function(p){ return p.supabase_id === pt.lieu_id; });
    if(!p){ noMatch++; return; }
    tourneeStops.push(p.id);
    if(pt.commandes_livraison && pt.commandes_livraison.length>0){
      tourneeStopTypes[p.id] = 'livraison';
      tourneeStopLivraisonDesc[p.id] = pt.commandes_livraison[0].description||'';
    }
  });

  var refPt = (pts||[]).find(function(pt){ return pt.quantite_flyers>0; });
