function parseDateFR(str){
  if(!str) return null;
  str = String(str).trim();
  if(!str) return null;
  var m = str.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if(m) return m[1]+'-'+m[2]+'-'+m[3];
  m = str.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
  if(m) return m[3]+'-'+m[2].padStart(2,'0')+'-'+m[1].padStart(2,'0');
  return null;
}

// Import des dates de saison (ouverture/fermeture) — modèle saisons_etablissements.xlsx exporté en CSV
async function importSaisons(input){
  var file = input.files[0]; if(!file) return;
  if(!getStoredSession()){ showToast('⚠ Connecte-toi à Supabase pour importer'); input.value=''; return; }
  var text = await file.text();
  var rows = parseCSVRobust(text);
  if(!rows.length){ showToast('⚠ Fichier vide ou illisible'); input.value=''; return; }

  showToast('🔍 Vérification des lieux…');
  var existingRaw;
  try{ existingRaw = await sbGet('lieux?select=id,nom,ville'); }
  catch(e){ showToast('❌ '+e.message); return; }
  var byNom = {};
  (existingRaw||[]).forEach(function(l){
    var key = (l.nom||'').toLowerCase().trim();
    if(!byNom[key]) byNom[key] = [];
    byNom[key].push(l);
  });

  var toUpsert = [], notFound = [], toUpdateSource = [];
  rows.forEach(function(r){
    var nom = r['nom du lieu'] || r.nom_lieu || r.nom || '';
    if(!nom.trim()) return;
    var key = nom.toLowerCase().trim();
    var matches = byNom[key] || [];
    var ville = r['ville'] || '';
    var lieu = (matches.length > 1 && ville)
      ? (matches.find(function(l){ return (l.ville||'').toLowerCase().trim() === ville.toLowerCase().trim(); }) || matches[0])
      : matches[0];
    if(!lieu){ notFound.push(nom); return; }

    var source = (r['source'] || r.source || '').trim();
    if(source) toUpdateSource.push({ id: lieu.id, source_horaires: source });

    var dOuv = parseDateFR(r["date d'ouverture"] || r.date_ouverture || '');
    var dFer = parseDateFR(r['date de fermeture'] || r.date_fermeture || '');
    if(!dOuv && !dFer) return;
    var annee = parseInt((dFer||dOuv).slice(0,4));
    toUpsert.push({
      lieu_id: lieu.id, annee,
      date_ouverture: dOuv, date_fermeture: dFer,
      commentaire: r['commentaire'] || r.commentaire || null,
      source: 'admin',
      maj_le: new Date().toISOString()
    });
  });

  if(!toUpsert.length && !toUpdateSource.length){ showToast('⚠ Aucune ligne exploitable (noms, dates ou source)'); input.value=''; return; }

  var existingSaisons;
  try{ existingSaisons = await sbGet('saisons_lieux?select=id,lieu_id,annee'); } catch(e){ existingSaisons = []; }
  var saisonKey = {};
  (existingSaisons||[]).forEach(function(s){ saisonKey[s.lieu_id+'_'+s.annee] = s.id; });

  var ok=0, errors=0;
  for(var i=0; i<toUpsert.length; i++){
    var d = toUpsert[i];
    var k = d.lieu_id+'_'+d.annee;
    try{
      if(saisonKey[k]) await sbPatch('saisons_lieux', 'id=eq.'+saisonKey[k], d);
      else await sbPost('saisons_lieux', d);
      ok++;
    } catch(e){ errors++; console.error('import saison', d, e.message); }
  }

  var okSource=0;
  for(var j=0; j<toUpdateSource.length; j++){
    var su = toUpdateSource[j];
    try{ await sbPatch('lieux', 'id=eq.'+su.id, {source_horaires: su.source_horaires}); okSource++; }
    catch(e){ errors++; console.error('update source', su, e.message); }
  }

  if(notFound.length) console.warn('Lieux non trouvés à l\'import saisons :', notFound);
  showToast('✅ '+ok+' saisons enregistrées'+(okSource?' · 🔗 '+okSource+' sources mises à jour':'')+(notFound.length?' · ❔ '+notFound.length+' non trouvés (détail console)':'')+(errors?' · ❌ '+errors+' erreurs':''), 6000);
  input.value='';
}

