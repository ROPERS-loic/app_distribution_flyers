function getToken(){var s=getStoredSession();return(s&&s.access_token)||SB_KEY;}
async function refreshSession(){var s=getStoredSession();if(!s||!s.refresh_token)return false;try{var d=await sbAuthPost('token?grant_type=refresh_token',{refresh_token:s.refresh_token});localStorage.setItem('sb-krbzipnoeroaofojccri-auth-token',JSON.stringify(d));return true;}catch(e){return false;}}
async function sbFetch(url,opts){var r=await fetch(url,opts);if(r.status===401){var ok=await refreshSession();if(ok){opts.headers['Authorization']='Bearer '+getToken();r=await fetch(url,opts);}}if(!r.ok){var e=await r.json().catch(function(){return{};});throw new Error(e.message||'HTTP '+r.status);}if(r.status===204)return null;return r.json();}
