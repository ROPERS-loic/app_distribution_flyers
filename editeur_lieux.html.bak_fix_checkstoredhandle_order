async function loadHistPanelForPoi(nomPoi) {
  var panel = document.getElementById('hist-panel');
  var content = document.getElementById('hist-panel-content');
  var countEl = document.getElementById('hist-panel-count');
  panel.style.display = 'block';
  content.innerHTML = '<div style="font-size:11px;color:#aaa;font-style:italic">Chargement…</div>';
  countEl.textContent = '';

  try {
    if(!getStoredSession()){ content.innerHTML = '<div style="font-size:11px;color:#aaa">Non connecté à Supabase</div>'; return; }

    // Chercher le lieu dans Supabase par nom
    var lieuxData = await sbGet('lieux?select=id&nom=eq.'+encodeURIComponent(nomPoi)+'&limit=1').catch(function(){return[];});
    if(!lieuxData || !lieuxData.length){ content.innerHTML = '<div style="font-size:11px;color:#aaa;font-style:italic">Lieu non synchronisé dans Supabase</div>'; return; }
    var lieuId = lieuxData[0].id;

    var yr = new Date().getFullYear();
    var data = await sbGet('points_tournee?select=id,statut,quantite_flyers,heure_validation,commentaire_distributeur,photo_preuve,tournees(nom,date,distributeur:utilisateurs(nom))&lieu_id=eq.'+lieuId+'&statut=neq.a_faire&heure_validation=not.is.null&order=heure_validation.desc').catch(function(){return[];});

    var list = data || [];
    var flyTotal = list.filter(function(p){return p.statut==='distribue';}).reduce(function(s,p){return s+(p.quantite_flyers||0);},0);
    var taux = list.length ? Math.round(list.filter(function(p){return p.statut==='distribue';}).length/list.length*100) : 0;

    countEl.textContent = list.length + ' passage' + (list.length>1?'s':'') + ' en '+yr;

    if(!list.length){
      content.innerHTML = '<div style="font-size:11px;color:#aaa;font-style:italic;padding:6px 0">Aucun passage enregistré en '+yr+'</div>';
      return;
    }

    var dotC={distribue:'#27AE60',ferme:'#888',refus:'#E53935',absent:'#E8870A'};
    var slbls={distribue:'✅ Distribué',ferme:'🔒 Fermé',refus:'🚫 Refus',absent:'👻 Absent'};

    var html = '<div class="hp-stats">'
      + (flyTotal?'<span class="hp-stat">🗞 '+flyTotal+' flyers</span>':'')
      + '<span class="hp-stat">✓ '+taux+'% réussite</span>'
      + '</div>';

    html += list.map(function(p){
      var d = p.heure_validation ? new Date(p.heure_validation) : null;
      var dateStr = d ? d.toLocaleDateString('fr-FR',{day:'2-digit',month:'short'}) : '—';
      var heureStr = d ? d.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'}) : '';
      var dist = p.tournees && p.tournees.distributeur ? p.tournees.distributeur.nom : '';
      return '<div class="hp-item">'
        + '<div class="hp-dot" style="background:'+( dotC[p.statut]||'#ccc')+'"></div>'
        + '<div style="flex:1;min-width:0">'
          + '<div style="display:flex;gap:6px;align-items:baseline">'
            + '<span class="hp-date">'+dateStr+(heureStr?' '+heureStr:'')+'</span>'
            + '<span class="hp-statut" style="color:'+(dotC[p.statut]||'#888')+'">'+( slbls[p.statut]||p.statut)+'</span>'
            + (p.quantite_flyers&&p.statut==='distribue'?'<span style="font-size:10px;color:#888">'+p.quantite_flyers+' fl.</span>':'')
          + '</div>'
          + '<div class="hp-meta">'
            + (p.tournees&&p.tournees.nom?'📋 '+escHtml(p.tournees.nom)+' ':'')
            + (dist?'👤 '+escHtml(dist):'')
          + '</div>'
          + (p.commentaire_distributeur?'<div class="hp-comment">💬 '+escHtml(p.commentaire_distributeur)+'</div>':'')
        + '</div>'
        + (p.photo_preuve?'<img src="'+p.photo_preuve+'" class="hp-photo" title="'+dateStr+'" onclick="window.open(\''+p.photo_preuve+'\',\'_blank\')" loading="lazy">':'')
      + '</div>';
    }).join('');

    content.innerHTML = html;
  } catch(e) {
    content.innerHTML = '<div style="font-size:11px;color:#aaa">Erreur : '+escHtml(e.message)+'</div>';
  }
}

