  POIS.forEach(function(p){ refreshMarkerIcon(p.id); });
  renderList(); renderTourneeList(); clearTourneeLayer();
  renderDepartArriveeSelects();

  if(pts && pts.length>0){
    var first = pts[0], last = pts[pts.length-1];
    if(first.quantite_flyers===0){
      var fp = POIS.find(function(p){ return p.supabase_id===first.lieu_id; });
      if(fp) document.getElementById('tf-depart').value = fp.id;
    }
    if(pts.length>1 && last.quantite_flyers===0){
      var lp = POIS.find(function(p){ return p.supabase_id===last.lieu_id; });
      if(lp) document.getElementById('tf-arrivee').value = lp.id;
    }
  }

  var saveBtn = document.getElementById('btn-save-tournee');
  if(saveBtn) saveBtn.textContent = '☁️ Mettre à jour la tournée';

  var msg = '✏️ Modification de "'+t.nom+'" — '+tourneeStops.length+' arrêt(s)';
  if(noMatch>0) msg += ' ('+noMatch+' lieu(x) introuvable(s) dans l\'éditeur)';
  showToast(msg);
}

async function saveTourneeSupabase(){
  var nom = document.getElementById('tf-nom').value.trim();
  var date = document.getElementById('tf-date').value;
  if(!nom || !date){ showToast('⚠ Nom et date obligatoires'); return; }
  if(tourneeStops.length === 0){ showToast('⚠ Ajoutez au moins 1 lieu'); return; }

  if(!getStoredSession()){ showToast('⚠ Non connecté à Supabase'); return; }

  var distId = document.getElementById('tf-distributeur').value || null;
  var qty = parseInt(document.getElementById('tf-qty').value) || 10;
  var secteur = document.getElementById('tf-secteur').value.trim();
  var comment = document.getElementById('tf-comment').value.trim();

  var departVal = document.getElementById('tf-depart') ? document.getElementById('tf-depart').value : '';
  var arriveeVal = document.getElementById('tf-arrivee') ? document.getElementById('tf-arrivee').value : '';
  var departId = departVal ? parseInt(departVal,10) : null;
  var arriveeId = arriveeVal ? parseInt(arriveeVal,10) : null;

  showToast(editingTourneeId ? '⏳ Mise à jour en cours…' : '⏳ Création en cours…');

  // Creer ou mettre a jour la tournee
  var tData;
  if(editingTourneeId){
    try {
      await sbPatch('tournees','id=eq.'+editingTourneeId, {nom:nom, date:date, distributeur_id:distId, secteur:secteur||null, commentaire:comment||null});
      await sbDelete('points_tournee','tournee_id=eq.'+editingTourneeId);
    } catch(e){ showToast('❌ Erreur mise à jour : '+e.message); return; }
    tData = {id: editingTourneeId};
  } else {
    var tArr;
    try { tArr = await sbPost('tournees', {nom:nom, date:date, distributeur_id:distId, secteur:secteur||null, commentaire:comment||null, statut:'planifiee'}); }
    catch(e){ showToast('❌ Erreur création : '+e.message); return; }
    tData = Array.isArray(tArr) ? tArr[0] : tArr;
  }

  // Points (p.supabase_id = UUID Supabase)
  var points = [];
  var poiIdByLieuId = {};
  tourneeStops.forEach(function(poiId, i){
    var p = POIS.find(function(p){ return p.id===poiId; }); if(!p) return;
    var isDepartArrivee = (departId!==null && poiId===departId) || (arriveeId!==null && poiId===arriveeId);
    points.push({ tournee_id: tData.id, lieu_id: p.supabase_id, ordre_passage: i+1, quantite_flyers: isDepartArrivee?0:qty, statut: 'a_faire' });
    poiIdByLieuId[p.supabase_id] = poiId;
  });
  var noMatch = tourneeStops.length - points.length;

  if(departId!==null && arriveeId!==null && departId===arriveeId){
    var loopPoi = POIS.find(function(p){ return p.id===departId; });
    if(loopPoi && loopPoi.supabase_id){
      points.push({ tournee_id: tData.id, lieu_id: loopPoi.supabase_id, ordre_passage: points.length+1, quantite_flyers: 0, statut: 'a_faire' });
    }
  }

  var insertedPoints = [];
  if(points.length > 0){
    try { insertedPoints = await sbPost('points_tournee', points); }
    catch(e){ showToast('❌ Erreur points : '+e.message); return; }
  }

  // Créer les commandes de livraison pour les arrêts marqués comme tels
  var livraisonRows = [];
  var userId = (getStoredSession()||{}).user ? getStoredSession().user.id : null;
  (insertedPoints||[]).forEach(function(pt){
    var poiId = poiIdByLieuId[pt.lieu_id];
    if(poiId===undefined || tourneeStopTypes[poiId] !== 'livraison') return;
    livraisonRows.push({
      lieu_id: pt.lieu_id, tournee_id: tData.id, point_tournee_id: pt.id,
      description: tourneeStopLivraisonDesc[poiId]||'', statut: 'a_livrer', cree_par: userId
    });
  });
  if(livraisonRows.length > 0){
    try { await sbPost('commandes_livraison', livraisonRows); }
    catch(e){ showToast('⚠ Tournée créée mais erreur livraisons : '+e.message); }
  }

  var msg = editingTourneeId ? ('✅ Tournée "'+nom+'" mise à jour — '+points.length+' arrêts') : ('✅ Tournée "'+nom+'" créée — '+points.length+' arrêts');
  if(livraisonRows.length>0) msg += ' dont '+livraisonRows.length+' livraison(s)';
  if(noMatch > 0) msg += ' ('+noMatch+' lieux non trouvés dans Supabase)';
  showToast(msg);

  // Réinitialiser
  tourneeStops = []; tourneeStopTypes = {}; tourneeStopLivraisonDesc = {};
  document.getElementById('tf-nom').value = '';
  document.getElementById('tf-secteur').value = '';
  document.getElementById('tf-comment').value = '';
  POIS.forEach(function(p){ refreshMarkerIcon(p.id); });
  renderList(); renderTourneeList(); clearTourneeLayer();
  document.getElementById('tournee-result').style.display = 'none';
  toggleTourneeMode();
}

