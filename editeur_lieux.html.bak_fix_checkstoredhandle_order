async function loadSaisonPanelForPoi(p) {
  var panel = document.getElementById('saison-panel');
  var content = document.getElementById('saison-panel-content');
  if (!p.supabase_id) { panel.style.display = 'none'; return; }
  panel.style.display = 'block';
  content.innerHTML = '<div style="font-size:11px;color:#aaa;font-style:italic">Chargement…</div>';
  try {
    var data = await sbGet('lieux?select=source_horaires,saisons_lieux(annee,date_ouverture,date_fermeture,commentaire)&id=eq.'+p.supabase_id);
    var lieu = data && data[0];
    if (!lieu) { content.innerHTML = '<div style="font-size:11px;color:#aaa">—</div>'; return; }
    var saisons = (lieu.saisons_lieux || []).slice().sort(function(a,b){ return b.annee - a.annee; });
    var html = '';
    if (saisons.length) {
      html += saisons.map(function(s){
        var ouv = s.date_ouverture ? new Date(s.date_ouverture).toLocaleDateString('fr-FR',{day:'2-digit',month:'short'}) : '';
        var fer = s.date_fermeture ? new Date(s.date_fermeture).toLocaleDateString('fr-FR',{day:'2-digit',month:'short'}) : '';
        var mid = (ouv && fer) ? ' · ' : '';
        var vide = (!ouv && !fer) ? '—' : '';
        var com = s.commentaire ? ' · '+escHtml(s.commentaire) : '';
        return '<div style="font-size:11px;margin-bottom:3px"><strong>'+s.annee+'</strong> — '+(ouv?'ouvre '+ouv:'')+mid+(fer?'ferme '+fer:'')+vide+com+'</div>';
      }).join('');
    } else {
      html += '<div style="font-size:11px;color:#aaa;font-style:italic">Aucune info de saison</div>';
    }
    if (lieu.source_horaires) {
      var isUrl = /^https?:\/\//.test(lieu.source_horaires);
      html += '<div style="font-size:10px;color:#888;margin-top:4px">🔗 '+(isUrl ? '<a href="'+escHtml(lieu.source_horaires)+'" target="_blank">'+escHtml(lieu.source_horaires)+'</a>' : escHtml(lieu.source_horaires))+'</div>';
    }
    html += '<div style="border-top:1px solid #eee;margin-top:8px;padding-top:8px">'
      + '<button class="btn-save" style="background:#8D6E63;font-size:11px;padding:6px 8px;width:100%" onclick="openSaisonsModal('+p.supabase_id+')">⚙️ Gérer les saisons</button>'
      + '</div>';
    content.innerHTML = html;
  } catch(e) { content.innerHTML = '<div style="font-size:11px;color:#c00">Erreur de chargement</div>'; }
}
