var GMAP_MAX = 10; // limite Google Maps

function _stopsToWps(stops){
  // Convertit un tableau de stops (objets ou ids) en waypoints lat,lon
  return stops.map(function(s){
    if(typeof s === 'number' || typeof s === 'string'){
      var p=POIS.find(function(p){return p.id===s;});
      return p ? p.lat+','+p.lon : null;
    }
    return s.lat+','+s.lon;
  }).filter(Boolean);
}

function _buildSegments(wps){
  // Découpe en segments de GMAP_MAX, chevauchés d'1 stop (jonction continue)
  var segs=[];
  for(var i=0;i<wps.length;i+=GMAP_MAX-1){
    var seg=wps.slice(i,Math.min(i+GMAP_MAX,wps.length));
    if(seg.length>=2) segs.push(seg);
  }
  return segs;
}

function _gmapURL(seg){
  return 'https://www.google.com/maps/dir/'+seg.join('/');
}

function openGmapModal(title, wps){
  if(wps.length<2){showToast('⚠ Minimum 2 arrêts');return;}
  var segs=_buildSegments(wps);
  document.getElementById('gmap-modal-title').textContent='🗺 '+title;
  var body=document.getElementById('gmap-box-body');
  body.innerHTML='';
  if(segs.length===1){
    // Moins de 10 arrêts : ouvrir directement
    window.open(_gmapURL(segs[0]),'_blank');
    return;
  }
  var info=document.createElement('p');
  info.textContent=wps.length+' arrêts → '+segs.length+' segments à ouvrir dans l\'ordre. Le dernier arrêt de chaque segment est le 1er du suivant.';
  body.appendChild(info);
  var allBtn=document.createElement('button');
  allBtn.className='gmap-all-btn';
  allBtn.innerHTML='🗺 Itinéraire complet ('+wps.length+' arrêts)';
  allBtn.onclick=function(){
    window.open(_gmapURL(wps),'_blank');
    closeGmapModal();
  };
  body.appendChild(allBtn);
  var sep=document.createElement('div');
  sep.style.cssText='border-top:1px solid #e0e0e0;margin:10px 0 8px;';
  body.appendChild(sep);
  segs.forEach(function(seg,i){
    var startNum=(i===0)?1:(i*(GMAP_MAX-1)+1);
    var endNum=Math.min(startNum+seg.length-1,wps.length);
    var btn=document.createElement('button');
    btn.className='gmap-seg-btn';
    btn.innerHTML='<div><div class="gmap-seg-label">Segment '+(i+1)+' / '+segs.length+'</div>'+'<div class="gmap-seg-sub">Arrêts '+startNum+' → '+endNum+'</div></div><span class="gmap-seg-arrow">→</span>';
    (function(url){ btn.onclick=function(){window.open(url,'_blank');}; })(_gmapURL(seg));
    body.appendChild(btn);
  });
  document.getElementById('gmap-modal').classList.add('open');
}

function closeGmapModal(){
  document.getElementById('gmap-modal').classList.remove('open');
}

function openInGoogleMaps(){
  if(routeStops.length<2){showToast('⚠ Minimum 2 arrêts');return;}
  var wps=_stopsToWps(routeStops);
  openGmapModal('Itinéraire en cours',wps);
}



