async function loadRappelsActuels(){
  try{
    var rows = await sbGet('rappels_lieux?select=id,lieu_id,commentaire,origine,cree_le&statut=eq.a_faire&order=lieu_id.asc,cree_le.desc');
    var map2 = {};
    rows.forEach(function(r){ if(!map2[r.lieu_id]) map2[r.lieu_id] = r; });
    rappelsMap = map2;
    rappelsLoaded = true;
  } catch(e){ rappelsMap = {}; }
}
function poiRappelActif(p){
  return !!(p.supabase_id && rappelsMap[p.supabase_id]);
}
function matchRappelFilter(p){
  var only = document.getElementById('filter-rappel-only');
  if(!only || !only.checked) return true;
  return poiRappelActif(p);
}
function passesCandidateFilters(p){
  return matchMoisSaison(p) && matchRappelFilter(p);
}
async function toggleRappelLieu(){
  var p = POIS.find(function(p){ return p.id===selectedId; }); if(!p||!p.supabase_id) return;
  var actif = rappelsMap[p.supabase_id];
  if(actif){
    if(!confirm('Marquer "'+p.nom+'" comme traité (retirer le rappel "à faire") ?')) return;
    try{
      await sbPatch('rappels_lieux','id=eq.'+actif.id,{statut:'traite',traite_le:new Date().toISOString()});
      delete rappelsMap[p.supabase_id];
      showToast('✓ Rappel traité : '+p.nom);
    }catch(e){ showToast('❌ '+e.message); return; }
  } else {
    var commentaire = prompt('Commentaire (optionnel) pour ce rappel "à faire" :', '');
    if(commentaire===null) return;
    try{
      var res = await sbPost('rappels_lieux',{lieu_id:p.supabase_id,commentaire:commentaire||null,origine:'bureau',statut:'a_faire'});
      var row = Array.isArray(res)?res[0]:res;
      rappelsMap[p.supabase_id] = row;
      showToast('🔁 Marqué à faire : '+p.nom);
    }catch(e){ showToast('❌ '+e.message); return; }
  }
  loadRappelPanelForPoi(p);
  refreshMarkerIcon(p.id);
  applyFilters();
}
async function removeRappelLieu(){
  var p = POIS.find(function(p){ return p.id===selectedId; }); if(!p||!p.supabase_id) return;
  var actif = rappelsMap[p.supabase_id]; if(!actif) return;
  if(!confirm('Retirer ce rappel "à faire" (erreur de saisie) ? Cette action est définitive.')) return;
  try{
    await sbDelete('rappels_lieux','id=eq.'+actif.id);
    delete rappelsMap[p.supabase_id];
    showToast('🗑 Rappel retiré : '+p.nom);
  }catch(e){ showToast('❌ '+e.message); return; }
  loadRappelPanelForPoi(p);
  refreshMarkerIcon(p.id);
  applyFilters();
}
function loadRappelPanelForPoi(p){
  var panel = document.getElementById('rappel-panel');
  var content = document.getElementById('rappel-panel-content');
  if(!p.supabase_id){ panel.style.display='none'; return; }
  panel.style.display = 'block';
  var actif = rappelsMap[p.supabase_id];
  if(actif){
    content.innerHTML = '<div style="font-size:11px;margin-bottom:6px"><strong>Ouvert</strong> — '
      + (actif.origine==='terrain'?'signalé sur le terrain':actif.origine==='pointage'?'signalé au pointage':'ajouté depuis le bureau')
      + (actif.cree_le?' le '+new Date(actif.cree_le).toLocaleDateString('fr-FR'):'')
      + (actif.commentaire?'<br><em>'+escHtml(actif.commentaire)+'</em>':'')
      + '</div><div style="display:flex;gap:5px"><button class="btn-save" style="background:#546E7A;font-size:11px;padding:5px 8px;flex:1" onclick="toggleRappelLieu()">✓ Marquer traité</button><button class="btn-save" style="background:#B0BEC5;font-size:11px;padding:5px 8px;flex:1" onclick="removeRappelLieu()">🗑 Retirer</button></div>';
  } else {
    content.innerHTML = '<div style="font-size:11px;color:#aaa;font-style:italic;margin-bottom:6px">Aucun rappel ouvert</div>'
      + '<button class="btn-save" style="background:#E53935;font-size:11px;padding:5px 8px" onclick="toggleRappelLieu()">🔁 Marquer à faire</button>';
  }
}
function addAllRappelsToTournee(){
  var candidats = filteredPois.filter(function(p){ return poiRappelActif(p) && tourneeStops.indexOf(p.id)<0; });
  if(!candidats.length){ showToast('⚠ Aucun lieu "à faire" à ajouter (parmi les lieux filtrés)'); return; }
  candidats.forEach(function(p){ tourneeStops.push(p.id); });
  POIS.forEach(function(p){ refreshMarkerIcon(p.id); });
  renderList(); renderTourneeList(); clearTourneeLayer();
  document.getElementById('tournee-result').style.display = 'none';
  showToast('✓ '+candidats.length+' lieu(x) "à faire" ajouté(s) à la tournée');
}
async function toggleSaisonsAffichage(){
  saisonsAffichage = !saisonsAffichage;
  var btn = document.getElementById('btn-toggle-saisons');
  if(saisonsAffichage){
    if(!saisonsLoaded){
      btn.textContent = '⏳ Chargement…';
      await loadSaisonsActuelles();
    }
    btn.textContent = '🔒 Saisons : ON';
    btn.style.background = '#E8A020';
    showToast('🔒 Lieux fermés / bientôt fermés affichés sur la carte');
  } else {
    btn.textContent = '🔒 Saisons : OFF';
    btn.style.background = '#78909C';
  }
  POIS.forEach(function(p){ refreshMarkerIcon(p.id); });
}
function zoneKey(zoneName){ return zoneName?zoneName.split(' ')[0]:''; }

function rebuildZoneSelects(){
  var fz=document.getElementById('filter-zone'); var prev=fz.value;
  fz.innerHTML='<option value="">Toutes les zones</option>';
  ZONES.forEach(function(z){ var o=document.createElement('option'); o.value=z.id; o.textContent=z.name; fz.appendChild(o); });
  fz.value=prev;
  var ez=document.getElementById('f-zone'); var prevE=ez.value;
  ez.innerHTML='';
  ZONES.forEach(function(z){ var o=document.createElement('option'); o.value=z.name; o.textContent=z.name; ez.appendChild(o); });
  ez.value=prevE;
  var leg=document.getElementById('legend-items'); leg.innerHTML='';
  ZONES.forEach(function(z){
    var div=document.createElement('div'); div.className='leg-item'; div.id='leg-'+z.id;
    div.innerHTML='<span class="leg-dot" style="background:'+z.color+'"></span><span class="leg-label">'+escHtml(z.name)+'</span>';
    div.onclick=function(){ filterZone(z.id); };
    leg.appendChild(div);
  });
}

