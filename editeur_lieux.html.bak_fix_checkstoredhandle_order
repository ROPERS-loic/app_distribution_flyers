var zoneEdits=[];
function openZoneModal(){
  zoneEdits=ZONES.map(function(z){return {id:z.id,name:z.name,color:z.color};});
  renderZoneEditor();
  document.getElementById('zone-modal').classList.add('open');
}
function renderZoneEditor(){
  var counts={}; POIS.forEach(function(p){ var k=zoneKey(p.zone_tournee); counts[k]=(counts[k]||0)+1; });
  var c=document.getElementById('zone-list-editor'); c.innerHTML='';
  zoneEdits.forEach(function(z,i){
    var div=document.createElement('div'); div.className='zone-row';
    div.innerHTML='<input type="color" class="zone-color-pick" value="'+z.color+'" data-i="'+i+'" oninput="zoneEdits[this.dataset.i].color=this.value">'
      +'<input class="zone-name-input" type="text" value="'+escHtml(z.name)+'" data-i="'+i+'" oninput="zoneEdits[this.dataset.i].name=this.value">'
      +'<span class="zone-count">'+(counts[z.id]||0)+' lieux</span>'
      +'<button class="zone-del-btn" onclick="removeZoneEdit('+i+')">✕</button>';
    c.appendChild(div);
  });
}
function removeZoneEdit(i){
  var z=zoneEdits[i];
  var count=POIS.filter(function(p){return zoneKey(p.zone_tournee)===z.id;}).length;
  if(count>0&&!confirm('Cette zone contient '+count+' lieu(x). Continuer ?')) return;
  zoneEdits.splice(i,1); renderZoneEditor();
}
function addZone(){
  var newId='Z'+(ZONES.length+1);
  zoneEdits.push({id:newId,name:'Nouvelle zone',color:'#9E9E9E'});
  renderZoneEditor();
  setTimeout(function(){ var ins=document.querySelectorAll('.zone-name-input'); if(ins.length) ins[ins.length-1].focus(); },50);
}
function saveZones(){
  ZONES.forEach(function(oldZ){
    var newZ=zoneEdits.find(function(z){return z.id===oldZ.id;});
    if(newZ&&newZ.name!==oldZ.name) POIS.forEach(function(p){ if(p.zone_tournee===oldZ.name) p.zone_tournee=newZ.name; });
  });
  ZONES.length=0; zoneEdits.forEach(function(z){ZONES.push({id:z.id,name:z.name,color:z.color});});
  POIS.forEach(function(p){refreshMarkerIcon(p.id);});
  rebuildZoneSelects(); applyFilters(); pushHistory(); saveState(); closeZoneModal();
  showToast('✓ Zones mises à jour');
}
function closeZoneModal(){ document.getElementById('zone-modal').classList.remove('open'); }

