//  IMPORT CSV / JSON EN MASSE
// ══════════════════════════════════════════════════════════
function parseCSVRobust(text){
  var clean = text.replace(/^\uFEFF/, '');
  var firstLine = clean.split('\n')[0];
  var sep = firstLine.split(';').length > firstLine.split(',').length ? ';' : ',';

  var rows = [];
  var field = '', inQuote = false, row = [];
  for(var i=0; i<clean.length; i++){
    var c = clean[i];
    if(inQuote){
      if(c==='"' && clean[i+1]==='"'){ field+='"'; i++; }
      else if(c==='"'){ inQuote=false; }
      else { field+=c; }
    } else {
      if(c==='"'){ inQuote=true; }
      else if(c===sep){ row.push(field.trim()); field=''; }
      else if(c==='\n'){ row.push(field.trim()); rows.push(row); row=[]; field=''; }
      else if(c!=='\r'){ field+=c; }
    }
  }
  if(field||row.length){ row.push(field.trim()); rows.push(row); }

  if(!rows.length) return [];
  var headers = rows[0].map(function(h){ return h.toLowerCase().replace(/"/g,'').trim(); });
  return rows.slice(1).filter(function(r){ return r.some(function(v){ return v; }); }).map(function(r){
    var obj={};
    headers.forEach(function(h,i){ obj[h]=(r[i]||'').replace(/^"|"$/g,'').trim(); });
    return obj;
  });
}

// Import CSV / JSON — insert si nouveau, mise à jour si le nom existe déjà
async function importLieux(input){
  var file = input.files[0]; if(!file) return;
  if(!getStoredSession()){ showToast('⚠ Connecte-toi à Supabase pour importer'); input.value=''; return; }
  var text = await file.text();
  var rows = [];
  if(file.name.endsWith('.json')){
    try{ rows = JSON.parse(text); }catch(e){ showToast('❌ JSON invalide'); return; }
  } else {
    rows = parseCSVRobust(text);
  }

  var mapped = rows.filter(function(r){ return r.nom||r.name; }).map(function(r){
    return {
      nom:          r.nom||r.name||'',
      categorie:    r.type_lieu||r.categorie||r.type||'',
      adresse:      r.adresse||r.address||'',
      code_postal:  r.code_postal||r.cp||'',
      ville:        r.commune||r.ville||r.city||'',
      latitude:     parseFloat(String(r.latitude||r.lat||'').replace(',','.'))||null,
      longitude:    parseFloat(String(r.longitude||r.lon||r.lng||'').replace(',','.'))||null,
      telephone:    r.telephone||r.tel||'',
      zone_tournee: r.zone_tournee||r.zone||'',
      actif: true
    };
  });

  if(!mapped.length){ showToast('⚠ Aucun lieu trouvé dans le fichier'); input.value=''; return; }

  showToast('🔍 Vérification des doublons…');
  var existingRaw;
  try{ existingRaw = await sbGet('lieux?select=id,nom'); }
  catch(e){ showToast('❌ Impossible de vérifier les doublons : '+e.message); return; }
  var existingByNom = {};
  (existingRaw||[]).forEach(function(l){ existingByNom[(l.nom||'').toLowerCase().trim()] = l; });

  var toInsert = [], toUpdate = [];
  mapped.forEach(function(data){
    var key = (data.nom||'').toLowerCase().trim();
    var existing = existingByNom[key];
    if(existing){ toUpdate.push({id: existing.id, data: data}); }
    else { toInsert.push(data); }
  });

  var inserted=0, updated=0, errors=0;

  for(var i=0; i<toInsert.length; i+=50){
    var batch = toInsert.slice(i, i+50);
    try{ await sbPost('lieux', batch); inserted += batch.length; }
    catch(e){ errors++; console.error('import insert lot', e.message); }
  }

  for(var j=0; j<toUpdate.length; j++){
    var u = toUpdate[j];
    try{ await sbPatch('lieux', 'id=eq.'+u.id, u.data); updated++; }
    catch(e){ errors++; console.error('import update', u.data.nom, e.message); }
  }

  showToast('✅ '+inserted+' insérés · '+updated+' mis à jour'+(errors?' · ❌ '+errors+' erreurs':''));
  input.value='';
  await autoSyncSupabase();
}

// Sync zones depuis un fichier zones_export.json — met à jour zone_tournee par nom de lieu
