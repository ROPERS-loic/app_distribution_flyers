async function saveSaisonRow(btn){
  var lieuId = _saisonsModalLieuId; if(!lieuId) return;
  var row = btn.closest('.saison-row');
  var annee = parseInt(row.querySelector('.sr-annee').value,10);
  if(!annee){ showToast('⚠ Année invalide'); return; }
  var dateOuverture = row.querySelector('.sr-ouverture').value || null;
  var dateFermeture = row.querySelector('.sr-fermeture').value || null;
  var commentaire = row.querySelector('.sr-commentaire').value.trim() || null;
  if(!dateOuverture && !dateFermeture){ showToast('⚠ Renseigne au moins une date'); return; }
  try{
    var sess = getStoredSession();
    var saisonId = row.getAttribute('data-saison-id');
    var payload = { lieu_id: lieuId, annee: annee, date_ouverture: dateOuverture, date_fermeture: dateFermeture, commentaire: commentaire, source: 'admin', maj_par: (sess&&sess.user&&sess.user.id)||null, maj_le: new Date().toISOString() };
    if(saisonId){
      await sbPatch('saisons_lieux','id=eq.'+saisonId,payload);
    } else {
      var existing = await sbGet('saisons_lieux?select=id&lieu_id=eq.'+lieuId+'&annee=eq.'+annee+'&limit=1');
      if(existing && existing[0]){ await sbPatch('saisons_lieux','id=eq.'+existing[0].id,payload); row.setAttribute('data-saison-id', existing[0].id); }
      else { var res = await sbPost('saisons_lieux',payload); var newId=(Array.isArray(res)?res[0]:res).id; row.setAttribute('data-saison-id', newId); }
    }
    showToast('✓ Saison '+annee+' enregistrée');
    _refreshSaisonPanelIfSameLieu(lieuId);
  } catch(e){ showToast('⚠ Erreur : '+e.message); }
}

