#stats-filters select:focus{border-color:#E8A020}
#stats-list{flex:1;overflow-y:auto;padding:10px 14px}
.sv-row{background:#fff;border:1px solid #e8e8e8;border-radius:7px;padding:9px 12px;margin-bottom:7px;display:flex;align-items:center;gap:10px;font-size:11px}
.sv-lieu{flex:1;min-width:0}
.sv-nom{font-weight:bold;color:#2B2B2B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sv-sub{font-size:10px;color:#888;margin-top:1px}
.sv-badge{padding:2px 7px;border-radius:10px;font-size:10px;font-weight:bold;white-space:nowrap;flex-shrink:0}
.sv-b-distribue{background:#E8F5E9;color:#27AE60}
.sv-b-ferme{background:#FFEBEE;color:#E53935}
.sv-b-refus{background:#FFF3E0;color:#E8A020}
.sv-b-absent{background:#EDE7F6;color:#8E24AA}
.sv-b-other{background:#f0f0f0;color:#666}
.sv-qty{font-weight:bold;color:#2B2B2B;white-space:nowrap;flex-shrink:0}
.sv-nougat{font-size:14px;flex-shrink:0}
.sv-date{font-size:10px;color:#999;white-space:nowrap;flex-shrink:0}
#stats-empty{text-align:center;padding:40px;color:#aaa;font-size:12px;font-style:italic}
:root{--gold-dk:#DBA10E;--grey:#6B6B6B;--grey-lt:#F0F0F0;--cream:#F7F6F2;--white:#fff;--green:#27AE60;--green-lt:#E8F8EF;--red:#E53935;--red-lt:#FFEBEE;--orange:#E8870A;--orange-lt:#FFF3E0}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:2000;display:none;align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal-box{background:var(--white);border-radius:16px;width:1000px;max-width:95vw;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.35);font-family:'Inter',Arial,sans-serif}
.modal-header{padding:22px 32px;border-bottom:1px solid var(--grey-lt);display:flex;align-items:flex-start;justify-content:space-between;position:sticky;top:0;background:var(--white);z-index:1}
.modal-header h3{font-family:'Montserrat',Arial,sans-serif;font-size:23px;font-weight:800;color:#1A1A1A}
.modal-header .fiche-subtitle{font-size:13px;color:var(--grey);margin-top:4px}
.modal-close{background:none;border:none;font-size:20px;color:var(--grey);line-height:1;cursor:pointer;width:32px;height:32px;border-radius:8px;flex-shrink:0}
.modal-close:hover{background:var(--grey-lt)}
.modal-body{padding:26px 32px 32px}
.badge{display:inline-block;padding:4px 11px;border-radius:20px;font-size:12px;font-weight:700;white-space:nowrap}
.b-distribue{background:var(--green-lt);color:var(--green)}
.b-ferme{background:var(--red-lt);color:var(--red)}
.b-refus{background:#F3E5F5;color:#7B1FA2}
.b-absent{background:var(--orange-lt);color:var(--orange)}
.fed-filter-btn{padding:6px 14px;border:none;border-radius:7px;font-size:13px;font-weight:700;cursor:pointer;font-family:'Inter',Arial,sans-serif}
.fiche-stats-d{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
.fsd-tile{background:var(--cream);border-radius:10px;padding:16px 10px;text-align:center}
.fsd-tile .sv{font-family:'Montserrat',Arial,sans-serif;font-size:28px;font-weight:800}
.fsd-tile .sl{font-size:11px;color:var(--grey);margin-top:4px}
.ftd-item{display:flex;gap:14px;padding:16px 0;border-bottom:1px solid var(--grey-lt)}
.ftd-item:last-child{border-bottom:none}
.ftd-dot{width:13px;height:13px;border-radius:50%;flex-shrink:0;margin-top:4px;border:2px solid white}
.ftd-content{flex:1;min-width:0}
.ftd-date{font-size:14px;font-weight:700;margin-bottom:6px;text-transform:capitalize}
.ftd-comment{font-size:13px;background:var(--cream);border-radius:7px;padding:8px 12px;margin-top:6px;color:#1A1A1A}
.ftd-photo{width:64px;height:64px;border-radius:8px;object-fit:cover;cursor:pointer;flex-shrink:0}
.photo-grid-d{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:24px}
.photo-grid-d img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:10px;cursor:pointer;display:block;transition:.15s}
.photo-grid-d img:hover{opacity:.8}
.photo-lb-d{position:fixed;inset:0;background:rgba(0,0,0,.93);z-index:3000;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px}
.photo-lb-d img{max-width:90vw;max-height:80vh;border-radius:8px;object-fit:contain}
.photo-lb-d-close{position:absolute;top:14px;right:16px;color:#fff;font-size:28px;cursor:pointer;line-height:1}
.loader-d{display:inline-block;width:14px;height:14px;border:2px solid rgba(0,0,0,.15);border-top-color:var(--gold-dk);border-radius:50%;animation:spin-d .7s linear infinite}
@keyframes spin-d{to{transform:rotate(360deg)}}
.btn-fiche{background:#1E88E5;color:#fff}
</style>
</head>
<body>
<!-- RESTORE BANNER -->
<div id="restore-banner" class="hidden">
