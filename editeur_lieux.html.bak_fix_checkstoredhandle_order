    POIS.push({
      id: id, supabase_id: l.id,
      nom: l.nom || '', type_lieu: l.categorie || '',
      commune: l.ville || '', code_postal: l.code_postal || '',
      departement: '', adresse: l.adresse || '',
      lat: String(l.latitude), lon: String(l.longitude),
      contacts: l.telephone || '', zone_tournee: l.zone_tournee || '',
      statut: '', source: 'Supabase'
    });
  });
  nextId = maxId + 1;
  Object.keys(markers).forEach(function(id) { map.removeLayer(markers[id]); });
  markers = {};
  document.getElementById('restore-banner').classList.add('hidden');
  await loadRappelsActuels();
  buildMarkers(); applyFilters(); saveState();
  showToast('✅ ' + POIS.length + ' lieux chargés depuis Supabase');
}

