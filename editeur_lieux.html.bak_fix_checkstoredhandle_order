#stats-summary{display:flex;gap:10px;padding:12px 14px;background:#fff;border-bottom:1px solid #e0e0e0;flex-shrink:0;flex-wrap:wrap}
.stat-card{flex:1;min-width:90px;background:#f9f9f9;border:1px solid #e8e8e8;border-radius:8px;padding:10px 12px;text-align:center}
