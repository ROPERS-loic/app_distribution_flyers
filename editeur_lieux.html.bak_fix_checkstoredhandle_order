async function getOrCreateJournalTournee(prefix){
  var today=new Date().toISOString().slice(0,10);
  var nomT=prefix+'_'+today;
  var existing=await sbGet('tournees?nom=eq.'+encodeURIComponent(nomT)+'&select=id').catch(function(){return[];});
  if(existing&&existing.length) return existing[0].id;
  var res=await sbPost('tournees',{nom:nomT,date:today,statut:'planifiee'});
  var t=Array.isArray(res)?res[0]:res;
  return t.id;
}
async function saveVisiteRapide(){
  var p=POIS.find(function(p){return p.id===_visitePoiId;});
  if(!p||!p.supabase_id){closeVisiteModal();return;}
  var statut=document.getElementById('visite-statut').value;
  var qty=parseInt(document.getElementById('visite-qty').value)||0;
  var qtyChateau=parseInt(document.getElementById('visite-qty-chateau').value)||0;
  var comment=document.getElementById('visite-comment').value.trim();
  var nougat=document.getElementById('visite-nougat').classList.contains('active');
  var entree=document.getElementById('visite-entree').classList.contains('active');
  if(nougat) comment=(comment?'[Nougat offert] '+comment:'[Nougat offert]');
  showToast('Enregistrement...');
  try{
    var tId=await getOrCreateJournalTournee('Visite_rapide');
    await sbPost('points_tournee',[{
      tournee_id:tId,lieu_id:p.supabase_id,ordre_passage:1,
      quantite_flyers:qty,quantite_flyers_chateau:qtyChateau,
      entree_gratuite:entree,statut:statut,
      heure_validation:new Date().toISOString(),
      commentaire_distributeur:comment||null
    }]);
    var rappelCheck=document.getElementById('visite-rappel').checked;
    var rappelComment=document.getElementById('visite-rappel-comment').value.trim();
    try{
      var existingRappel=rappelsMap[p.supabase_id];
      if(existingRappel){
        await sbPatch('rappels_lieux','id=eq.'+existingRappel.id,{statut:'traite',traite_le:new Date().toISOString()});
        delete rappelsMap[p.supabase_id];
      }
      if(rappelCheck){
        var rRes=await sbPost('rappels_lieux',{lieu_id:p.supabase_id,commentaire:rappelComment||null,origine:'pointage',statut:'a_faire'});
        rappelsMap[p.supabase_id]=Array.isArray(rRes)?rRes[0]:rRes;
      }
      refreshMarkerIcon(p.id);
    }catch(e2){ console.warn('rappel error', e2.message); }
    showToast('Visite enregistree : '+p.nom);
    closeVisiteModal();
    loadHistPanelForPoi(p.nom);
  }catch(e){showToast('Erreur : '+e.message);}
}

