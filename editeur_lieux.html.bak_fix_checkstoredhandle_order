//  STATISTIQUES
// ══════════════════════════════════════════════════════════
var _statsData = [];

async function openStats(){
  document.getElementById('stats-modal').classList.add('open');
  document.getElementById('stats-empty').textContent = 'Chargement…';
  document.getElementById('stats-list').innerHTML = '<div id="stats-empty">Chargement…</div>';
  try {
    var data = await sbGet('points_tournee?select=id,statut,quantite_flyers,heure_validation,commentaire_distributeur,lieu_id,lieux(nom,ville,categorie),tournees(nom,date,distributeur:utilisateurs(nom))&statut=neq.a_faire&heure_validation=not.is.null&order=heure_validation.desc&limit=1000');
    _statsData = data || [];
    applyStatsFilters();
  } catch(e) {
    document.getElementById('stats-list').innerHTML = '<div id="stats-empty">Erreur de chargement : '+e.message+'</div>';
  }
}

function closeStats(){
  document.getElementById('stats-modal').classList.remove('open');
}

function applyStatsFilters(){
  var periode = document.getElementById('sf-periode').value;
  var statut  = document.getElementById('sf-statut').value;
  var nougat  = document.getElementById('sf-nougat').value;
  var sort    = document.getElementById('sf-sort').value;

  var now = new Date();
  var filtered = _statsData.filter(function(p){
    if(statut && p.statut !== statut) return false;
    if(nougat === '1' && !(p.commentaire_distributeur||'').includes('[Nougat offert]')) return false;
    if(nougat === '0' && (p.commentaire_distributeur||'').includes('[Nougat offert]')) return false;
    if(periode !== 'all' && p.heure_validation){
      var d = new Date(p.heure_validation);
      if(periode === 'month' && (d.getMonth()!==now.getMonth()||d.getFullYear()!==now.getFullYear())) return false;
      if(periode === 'year' && d.getFullYear()!==now.getFullYear()) return false;
    }
    return true;
  });

  filtered.sort(function(a,b){
    if(sort==='date_desc') return new Date(b.heure_validation||0)-new Date(a.heure_validation||0);
    if(sort==='date_asc')  return new Date(a.heure_validation||0)-new Date(b.heure_validation||0);
    if(sort==='lieu_az')   return ((a.lieux&&a.lieux.nom)||'').localeCompare((b.lieux&&b.lieux.nom)||'');
    if(sort==='qty_desc')  return (b.quantite_flyers||0)-(a.quantite_flyers||0);
    return 0;
  });

  // Résumé
  var total   = filtered.length;
  var dist    = filtered.filter(function(p){return p.statut==='distribue';});
  var paquets = dist.reduce(function(s,p){return s+(p.quantite_flyers||0);},0);
  var taux    = total ? Math.round(dist.length/total*100)+'%' : '—';
  var nougats = filtered.filter(function(p){return (p.commentaire_distributeur||'').includes('[Nougat offert]');}).length;
  document.getElementById('sc-total').textContent   = total;
  document.getElementById('sc-paquets').textContent = paquets;
  document.getElementById('sc-taux').textContent    = taux;
  document.getElementById('sc-nougat').textContent  = nougats;

  // Liste
  var el = document.getElementById('stats-list');
  if(!filtered.length){ el.innerHTML='<div id="stats-empty">Aucun résultat</div>'; return; }

  var badgeClass = {distribue:'sv-b-distribue',ferme:'sv-b-ferme',refus:'sv-b-refus',absent:'sv-b-absent'};
  var badgeLabel = {distribue:'Distribué',ferme:'Fermé',refus:'Refus',absent:'Absent'};
  el.innerHTML = filtered.map(function(p){
    var l = p.lieux || {};
    var t = p.tournees || {};
    var d = p.heure_validation ? new Date(p.heure_validation) : null;
    var dateStr = d ? d.toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit',year:'2-digit'}) : '—';
    var isNougat = (p.commentaire_distributeur||'').includes('[Nougat offert]');
    var comment = (p.commentaire_distributeur||'').replace('[Nougat offert]','').trim();
    var bc = badgeClass[p.statut]||'sv-b-other';
    var bl = badgeLabel[p.statut]||p.statut;
    var qtyStr = p.statut==='distribue' ? (p.quantite_flyers||0)+' pqt' : '';
    return '<div class="sv-row">'
      +'<div class="sv-lieu">'
        +'<div class="sv-nom">'+(l.nom||'—')+'</div>'
        +'<div class="sv-sub">'+(l.ville||'')+(l.categorie?' · '+l.categorie:'')+(t.distributeur?(' · '+t.distributeur.nom):'')+'</div>'
        +(comment?'<div class="sv-sub" style="font-style:italic">'+comment+'</div>':'')
      +'</div>'
      +'<span class="sv-badge '+bc+'">'+bl+'</span>'
      +(qtyStr?'<span class="sv-qty">'+qtyStr+'</span>':'')
      +(isNougat?'<span class="sv-nougat" title="Nougat offert">🍬</span>':'')
      +'<span class="sv-date">'+dateStr+'</span>'
    +'</div>';
  }).join('');
}

