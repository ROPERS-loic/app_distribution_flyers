</div>
<div id="header">
  <h1>🗺 Éditeur de lieux – Nougaterie du Pont d'Arc</h1>
  <span id="total-badge">290 lieux</span>

  <div class="hbtn-dropdown">
    <button class="hbtn hbtn-dropdown-trigger" onclick="toggleHeaderDropdown('carte')" style="background:#1E88E5;color:#fff">🗺️ Carte <span class="caret">▾</span></button>
    <div class="hbtn-dropdown-menu" id="dd-menu-carte">
      <button class="hbtn" id="btn-add" onclick="toggleAddMode()">➕ Ajouter</button>
      <button class="hbtn" id="btn-route" onclick="toggleRouteMode()">📍 Itinéraire</button>
      <button class="hbtn" id="btn-tournee" onclick="toggleTourneeMode()" style="background:#27AE60;color:#fff">🗺️ Créer tournée</button>
      <button class="hbtn" id="btn-pointage" onclick="togglePointageMode()" style="background:#8E24AA;color:#fff">Pointage</button>
    </div>
  </div>

  <div class="hbtn-dropdown">
    <button class="hbtn hbtn-dropdown-trigger" onclick="toggleHeaderDropdown('affichage')" style="background:#00897B;color:#fff">🎨 Affichage <span class="caret">▾</span></button>
    <div class="hbtn-dropdown-menu" id="dd-menu-affichage">
      <button class="hbtn" id="btn-zones" onclick="openZoneModal()">🎨 Zones</button>
      <button class="hbtn" id="btn-toggle-saisons" onclick="toggleSaisonsAffichage()" style="background:#78909C;color:#fff" title="Afficher/masquer sur la carte les lieux fermés ou bientôt fermés (saison)">🔒 Saisons : OFF</button>
    </div>
  </div>

  <div class="hbtn-dropdown">
    <button class="hbtn hbtn-dropdown-trigger" onclick="toggleHeaderDropdown('import')" style="background:#455A64;color:#fff">📦 Import / Export <span class="caret">▾</span></button>
    <div class="hbtn-dropdown-menu" id="dd-menu-import">
      <button class="hbtn" id="btn-generer-import-saisons" onclick="genererFichierImportSaisons()" style="background:#455A64;color:#fff" title="Générer un fichier CSV (tous les lieux) prêt à remplir avec les dates de saison — inclut les sources déjà connues">📥 Générer fichier d'import</button>
      <button class="hbtn" id="btn-import-lieux" onclick="document.getElementById('csv-import-input').click()" style="background:#8D6E63;color:#fff" title="Importer des lieux depuis un fichier CSV ou JSON">📂 Importer CSV</button>
      <button class="hbtn" id="btn-import-zones" onclick="document.getElementById('zones-import-input').click()" style="background:#546E7A;color:#fff" title="Synchroniser les zones de tournée depuis un fichier zones_export.json">🗂 Sync zones</button>
      <button class="hbtn" id="btn-import-saisons" onclick="document.getElementById('saisons-import-input').click()" style="background:#2E7D32;color:#fff" title="Importer les dates d'ouverture/fermeture depuis un CSV (modèle saisons_etablissements.xlsx exporté en CSV)">🗓 Importer saisons</button>
    </div>
  </div>
  <input type="file" id="csv-import-input" accept=".csv,.json" style="display:none" onchange="importLieux(this)">
  <input type="file" id="zones-import-input" accept=".json" style="display:none" onchange="importZones(this)">
  <input type="file" id="saisons-import-input" accept=".csv" style="display:none" onchange="importSaisons(this)">

  <button class="hbtn" id="btn-undo" onclick="undoState()" disabled title="Annuler la dernière modification">↩ Annuler</button>
  <button class="hbtn" id="btn-reset" onclick="resetToOriginal()" style="background:#546E7A;color:#fff" title="Effacer les sauvegardes locales et revenir aux données d'origine">↺ Réinitialiser</button>
</div>

