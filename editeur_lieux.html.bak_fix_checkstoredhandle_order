function ficheTimelineEditeurHTML(list,dotC,bgC,txtC,slbls){
  if(!list.length) return '<div style="text-align:center;padding:30px;color:var(--grey);font-size:13px">Aucun passage enregistré</div>';
  return list.map(function(pt){
    var d = pt.heure_validation ? new Date(pt.heure_validation) : null;
    var dateStr = d ? d.toLocaleDateString('fr-FR',{weekday:'long',day:'2-digit',month:'long',year:'numeric'}) : (pt.tournees&&pt.tournees.date||'—');
    var heureStr = d ? d.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'}) : '';
    var dist = (pt.tournees&&pt.tournees.distributeur&&pt.tournees.distributeur.nom) || '';
    return '<div class="ftd-item">'
      + '<div class="ftd-dot" style="background:'+(dotC[pt.statut]||'#ccc')+';box-shadow:0 0 0 2px '+(dotC[pt.statut]||'#ccc')+'"></div>'
      + '<div class="ftd-content" style="flex:1">'
      + '<div class="ftd-date">'+escHtml(dateStr)+(heureStr?' · '+heureStr:'')+'</div>'
      + '<div style="margin:3px 0">'
      + '<span class="badge" style="background:'+bgC[pt.statut]+';color:'+txtC[pt.statut]+'">'+(slbls[pt.statut]||pt.statut)+'</span>'
      + (pt.statut==='distribue'&&pt.quantite_flyers?'<span style="font-size:11px;color:var(--grey);margin-left:6px">🗞 '+pt.quantite_flyers+' flyers</span>':'')
      + (pt.tournees&&pt.tournees.nom?'<span style="font-size:11px;color:var(--grey);margin-left:6px">📋 '+escHtml(pt.tournees.nom)+'</span>':'')
      + (dist?'<span style="font-size:11px;color:var(--grey);margin-left:6px">👤 '+escHtml(dist)+'</span>':'')
      + '</div>'
      + (pt.commentaire_distributeur?'<div class="ftd-comment">💬 '+escHtml(pt.commentaire_distributeur)+'</div>':'')
      + '</div>'
      + (pt.photo_preuve?'<img src="'+pt.photo_preuve+'" class="ftd-photo" loading="lazy" data-caption="'+escHtml(dateStr)+'" onclick="openPhotoLbEditeur(this.src,this.dataset.caption)" alt="Photo">':'')
      + '</div>';
  }).join('');
}

