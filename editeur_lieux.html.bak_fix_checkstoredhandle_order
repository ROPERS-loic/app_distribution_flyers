.hp-date{font-weight:bold;color:#333;min-width:70px;flex-shrink:0}
.hp-statut{font-weight:bold}
.hp-meta{color:#888;font-size:10px;margin-top:1px}
.hp-comment{font-size:10px;color:#555;background:#f5f5f5;border-radius:4px;padding:3px 6px;margin-top:3px;font-style:italic}
