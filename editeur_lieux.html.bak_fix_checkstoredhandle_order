.hp-stats{display:flex;gap:8px;margin-bottom:7px;flex-wrap:wrap}
.hp-stat{background:#f0f0f0;border-radius:4px;padding:3px 8px;font-size:10px;font-weight:bold;color:#333}

/* TOAST */
#toast{position:fixed;bottom:14px;left:50%;transform:translateX(-50%);background:#2B2B2B;color:#fff;padding:8px 15px;border-radius:7px;font-size:12px;z-index:9999;display:none;border-left:4px solid #E8A020;white-space:nowrap}
/* STATS MODAL */
#stats-modal{display:none;position:fixed;inset:0;background:#f5f5f5;z-index:3000;flex-direction:column}
