var filteredPois=POIS.slice();
function applyFilters(){
  var q=norm(document.getElementById('search-input').value).trim();
  var zf=document.getElementById('filter-zone').value;
  var tf=document.getElementById('filter-type').value;
  var sf=document.getElementById('filter-statut')?document.getElementById('filter-statut').value:'';
  filteredPois=POIS.filter(function(p){
    var statOk=!sf||(sf==='active'?(!p.statut||p.statut===''):
      p.statut===sf);
    return (!q||norm(p.nom+' '+p.commune).includes(q))
      &&(!zf||zoneKey(p.zone_tournee)===zf)
      &&(!tf||p.type_lieu===tf)
      &&statOk
      &&passesCandidateFilters(p);
  });
  renderList();
  updateMarkersVisibility();
}
async function onMoisFilterChange(){
  var mois = document.getElementById('filter-mois-saison').value;
  if(mois && !saisonsLoaded){
    showToast('⏳ Chargement des saisons…');
    await loadSaisonsActuelles();
  }
  applyFilters();
}
function renderList(){
  var list=document.getElementById('poi-list'); list.innerHTML='';
  filteredPois.forEach(function(p){
    var color=zoneColor(p.zone_tournee);
    var rn=routeStops.indexOf(p.id);
    var statCls=(p.statut==='closed_perm'||p.statut==='closed_temp')?' statut-dim':'';
    var statBadge=p.statut==='no_flyer'?'<span class="statut-badge statut-no-flyer">🚫 flyers</span>':
      p.statut==='closed_perm'?'<span class="statut-badge statut-closed-perm">🔒 fermé</span>':
      p.statut==='closed_temp'?'<span class="statut-badge statut-closed-temp">⏳ fermé</span>':'';
    var div=document.createElement('div');
    div.className='poi-item'+(selectedId===p.id?' selected':'')+(rn>=0?' route-selected':'')+statCls;
    div.id='li-'+p.id;
    div.innerHTML=(rn>=0?'<div class="route-num">'+(rn+1)+'</div>':'')
      +'<div class="poi-dot" style="background:'+color+'"></div>'
      +'<div class="poi-info"><div class="poi-nom">'+escHtml(p.nom)+statBadge+'</div><div class="poi-sub">'+escHtml(p.type_lieu)+' · '+escHtml(p.commune)+' · '+escHtml(zoneKey(p.zone_tournee))+'</div></div>';
    div.onclick=function(){ tourneeMode?tourneeClickLieu(p.id):pointageMode?togglePointageStop(p.id):routeMode?toggleRouteStop(p.id):selectPoi(p.id); };
    list.appendChild(div);
  });
  document.getElementById('poi-count').textContent=filteredPois.length+' lieu'+(filteredPois.length>1?'x':'');
  document.getElementById('total-badge').textContent=POIS.length+' lieux';
}

