  if(stops.length>=2){
    try{
      var wps=stops.map(function(s){return[parseFloat(s.lat),parseFloat(s.lon)];}).filter(function(c){return !isNaN(c[0]);});
      if(wps.length>=2){
        var totalDist=0,totalDur=0,MAX=25;
        for(var s=0;s<wps.length-1;s+=MAX-1){
          var batch=wps.slice(s,Math.min(s+MAX,wps.length));
