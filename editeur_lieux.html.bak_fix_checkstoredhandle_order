            d.routes[0].geometry.coordinates.forEach(function(c){allCoords.push([c[1],c[0]]);});
          }
        }
        km=(totalDist/1000).toFixed(1);
        var h=Math.floor(totalDur/3600),m=Math.round((totalDur%3600)/60);
