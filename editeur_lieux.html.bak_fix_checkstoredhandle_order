function selectPoi(id){
  var prev=selectedId; if(prev!==null){ selectedId=null; refreshMarkerIcon(prev); var li=document.getElementById('li-'+prev); if(li)li.classList.remove('selected'); }
  selectedId=id; var p=POIS.find(function(p){return p.id===id;}); if(!p) return;
  refreshMarkerIcon(id);
  if(markers[id]) map.panTo(markers[id].getLatLng(),{animate:true});
  var li=document.getElementById('li-'+id); if(li){li.classList.add('selected');li.scrollIntoView({block:'nearest'});}
  document.getElementById('edit-title').textContent='✏️ '+p.nom;
  document.getElementById('f-nom').value=p.nom;
  document.getElementById('f-type').value=p.type_lieu;
  document.getElementById('f-commune').value=p.commune;
  document.getElementById('f-cp').value=p.code_postal;
  document.getElementById('f-dept').value=p.departement;
  document.getElementById('f-adresse').value=p.adresse;
  document.getElementById('f-zone').value=p.zone_tournee;
  document.getElementById('f-lat').value=p.lat;
  document.getElementById('f-lon').value=p.lon;
  document.getElementById('f-contact').value=p.contacts;
  document.getElementById('f-statut').value=p.statut||'';
  document.getElementById('edit-panel').classList.remove('hidden');
  // Charger historique Supabase
  loadHistPanelForPoi(p.nom);
  loadSaisonPanelForPoi(p);
  loadRappelPanelForPoi(p);
}
function saveEdit(){
  var p=POIS.find(function(p){return p.id===selectedId;}); if(!p) return;
  p.nom=document.getElementById('f-nom').value.trim();
  p.type_lieu=document.getElementById('f-type').value;
  p.commune=document.getElementById('f-commune').value.trim();
  p.code_postal=document.getElementById('f-cp').value.trim();
  p.departement=document.getElementById('f-dept').value.trim();
  p.adresse=document.getElementById('f-adresse').value.trim();
  p.zone_tournee=document.getElementById('f-zone').value;
  p.lat=document.getElementById('f-lat').value;
  p.lon=document.getElementById('f-lon').value;
  p.contacts=document.getElementById('f-contact').value.trim();
  p.statut=document.getElementById('f-statut').value;
  var lat=parseFloat(p.lat),lon=parseFloat(p.lon);
  if(markers[p.id]&&!isNaN(lat)&&!isNaN(lon)) markers[p.id].setLatLng([lat,lon]);
  refreshMarkerIcon(p.id);
  document.getElementById('edit-title').textContent='✏️ '+p.nom;
  applyFilters(); pushHistory(); saveState(); savePOIToSupabase(p); showToast('✓ Modifié : '+p.nom);
}
function deletePoi(){
  var p=POIS.find(function(p){return p.id===selectedId;}); if(!p) return;
  if(p.type_lieu==='Point de départ'){showToast('⚠ Impossible de supprimer le point de départ');return;}
  if(!confirm('Retirer "'+p.nom+'" de la carte (localement, sans toucher à la base) ?')) return;
  if(markers[p.id]){map.removeLayer(markers[p.id]);delete markers[p.id];}
  POIS.splice(POIS.indexOf(p),1);
  routeStops=routeStops.filter(function(id){return id!==p.id;});
  selectedId=null;
  document.getElementById('edit-panel').classList.add('hidden');
  applyFilters(); renderRouteList(); pushHistory(); saveState(); showToast('🗑 Retiré de la carte : '+p.nom);
}

async function deletePoiSupabase(){
  var p=POIS.find(function(p){return p.id===selectedId;}); if(!p) return;
  if(p.type_lieu==='Point de départ'){showToast('⚠ Impossible de supprimer le point de départ');return;}
  if(!p.supabase_id){ showToast('⚠ Ce lieu n\'est pas encore synchronisé avec Supabase — utilisez le bouton 🗑 pour le retirer localement'); return; }
  var saisie = prompt('Suppression DÉFINITIVE et IRRÉVERSIBLE dans la base (aucune sauvegarde disponible). Tapez le nom exact du lieu pour confirmer :\n\n'+p.nom);
  if(saisie === null) return;
  if(saisie.trim() !== p.nom.trim()){ showToast('⚠ Le nom saisi ne correspond pas — suppression annulée'); return; }
  try{
    await sbDelete('lieux','id=eq.'+p.supabase_id);
  } catch(e){
    var msg = (e && e.message) || '';
    if(/foreign key|violates|update or delete/i.test(msg)){
      showToast('⚠ Impossible : ce lieu a un historique de tournées. Utilisez plutôt le statut "Fermé définitivement".');
    } else {
      showToast('❌ '+msg);
    }
    return;
  }
  if(markers[p.id]){map.removeLayer(markers[p.id]);delete markers[p.id];}
  POIS.splice(POIS.indexOf(p),1);
  routeStops=routeStops.filter(function(id){return id!==p.id;});
  selectedId=null;
  document.getElementById('edit-panel').classList.add('hidden');
  applyFilters(); renderRouteList(); pushHistory(); saveState();
  showToast('🗑 Supprimé définitivement (base) : '+p.nom);
}
function closeEdit(){
  if(selectedId!==null){selectedId=null; POIS.forEach(function(p){refreshMarkerIcon(p.id);});}
  document.getElementById('edit-panel').classList.add('hidden');
  document.getElementById('hist-panel').style.display='none';
  document.getElementById('saison-panel').style.display='none';
  document.getElementById('rappel-panel').style.display='none';
  document.querySelectorAll('.poi-item.selected').forEach(function(e){e.classList.remove('selected');});
}

