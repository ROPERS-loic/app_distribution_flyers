function toggleAddMode(){
  addMode=!addMode;
  var btn=document.getElementById('btn-add');
  btn.textContent=addMode?'✕ Annuler':'➕ Ajouter';
  btn.classList.toggle('active',addMode);
  document.getElementById('add-banner').style.display=addMode?'block':'none';
  map.getContainer().style.cursor=addMode?'crosshair':'';
}
function createNewPoi(lat,lon){
  var id=nextId++;
  var p={id:id,departement:'',commune:'',code_postal:'',type_lieu:'Camping',nom:'Nouveau lieu',adresse:'',lat:lat.toFixed(6),lon:lon.toFixed(6),contacts:'',source:'Manuel',zone_tournee:ZONES.length>0?ZONES[1].name:'',classements:'',description:''};
  POIS.push(p);
  var m=L.marker([lat,lon],{draggable:true,icon:makeIcon(zoneColor(p.zone_tournee),false,null)}).addTo(map);
  m.on('click',function(){routeMode?toggleRouteStop(id):selectPoi(id);});
  m.on('dragend',function(e){var ll=e.target.getLatLng();p.lat=ll.lat.toFixed(6);p.lon=ll.lng.toFixed(6);if(selectedId===id){document.getElementById('f-lat').value=p.lat;document.getElementById('f-lon').value=p.lon;}});
  markers[id]=m; applyFilters(); selectPoi(id); pushHistory(); saveState();
  showToast('📍 Nouveau lieu — remplissez le formulaire');
}

