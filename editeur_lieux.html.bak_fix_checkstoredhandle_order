async function autoSyncSupabase() {
  if (!getStoredSession()) return;
  var data;
  try { data = await sbGet('lieux?select=*&actif=eq.true&order=nom'); } catch(e){ return; }
  if (!data || !data.length) { if(POIS.length>0) syncSupabase(); return; }
  POIS.length = 0;
  var maxId = 0;
  data.forEach(function(l) {
