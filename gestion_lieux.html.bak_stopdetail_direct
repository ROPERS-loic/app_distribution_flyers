<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gestion – Nougaterie du Pont d'Arc</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
:root{
  --gold:#F5C21A;--gold-dk:#DBA10E;--gold-lt:#FFF8DC;
  --black:#1A1A1A;--grey:#6B6B6B;--grey-lt:#F0F0F0;
  --cream:#F7F6F2;--white:#fff;
  --green:#27AE60;--green-lt:#E8F8EF;
  --red:#E53935;--red-lt:#FFEBEE;
  --orange:#E8870A;--orange-lt:#FFF3E0;
  --blue:#2563EB;--blue-lt:#EFF6FF;
  --header:54px;
  --radius:10px;--shadow:0 2px 12px rgba(0,0,0,.09);
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;background:var(--cream);color:var(--black);height:100vh;overflow:hidden}
h1,h2,h3,.title{font-family:'Montserrat',sans-serif}
button{cursor:pointer;font-family:'Inter',sans-serif}
input,select,textarea{font-family:'Inter',sans-serif}
a{color:inherit;text-decoration:none}

/* LOGIN */
#login-screen{display:flex;align-items:center;justify-content:center;height:100vh;background:#F7F6F2}
.login-card{background:var(--white);border-radius:16px;padding:40px;width:360px;box-shadow:0 4px 24px rgba(0,0,0,.12)}
.login-logo{text-align:center;margin-bottom:24px}
.login-logo img{max-width:200px;width:80%;height:auto;margin-bottom:8px}
.login-logo h2{font-size:18px;font-weight:800;margin-top:8px;color:var(--black)}
.login-logo p{font-size:12px;color:var(--grey);margin-top:4px}
.login-field{margin-bottom:14px}
.login-field label{display:block;font-size:11px;font-weight:700;color:var(--grey);text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px}
.login-field input{width:100%;padding:11px 13px;border:1.5px solid #E5E5E5;border-radius:var(--radius);font-size:14px;outline:none;transition:.15s}
.login-field input:focus{border-color:var(--gold)}
.login-err{background:var(--red-lt);color:var(--red);border-radius:var(--radius);padding:10px;font-size:12px;margin-bottom:12px;display:none}
.btn-login{width:100%;padding:13px;background:var(--gold);color:var(--black);border:none;border-radius:var(--radius);font-family:'Montserrat',sans-serif;font-size:14px;font-weight:700;margin-top:4px}
.btn-login:hover{background:var(--gold-dk)}

/* APP SHELL */
#app{display:none;height:100vh;flex-direction:column}
#app.visible{display:flex}

/* Header */
#app-header{height:var(--header);background:var(--black);color:var(--white);display:flex;align-items:center;padding:0 16px;gap:14px;flex-shrink:0;z-index:100}
.hdr-logo{font-family:'Montserrat',sans-serif;font-size:13px;font-weight:800;display:flex;align-items:center;gap:8px}
.hdr-logo .bee{font-size:20px}
.hdr-tabs{display:flex;gap:2px;margin-left:8px;flex-wrap:nowrap;overflow-x:auto}
.hdr-tab{padding:7px 14px;border:none;background:none;color:rgba(255,255,255,.55);border-radius:7px;font-size:12px;font-weight:600;transition:.15s;white-space:nowrap}
.hdr-tab:hover{background:rgba(255,255,255,.1);color:var(--white)}
.hdr-tab.active{background:var(--gold);color:var(--black)}
.hdr-spacer{flex:1}
.hdr-user{font-size:12px;color:rgba(255,255,255,.7);display:flex;align-items:center;gap:8px;flex-shrink:0}
.btn-logout{padding:6px 12px;background:rgba(255,255,255,.1);border:none;border-radius:7px;color:var(--white);font-size:11px;font-weight:600}
.btn-logout:hover{background:rgba(255,255,255,.2)}

/* Body */
#app-body{flex:1;overflow:hidden;display:flex;flex-direction:column}

/* Sections */
.section{display:none;flex:1;overflow-y:auto;padding:20px}
.section.active{display:block}
#section-carte{display:none;flex:1;overflow:hidden;padding:0}
#section-carte.active{display:flex;flex-direction:column}
#section-editeur{display:none;flex:1;overflow:hidden;padding:0}
#section-editeur.active{display:flex;flex-direction:column}

/* COMMON */
.page-title{font-size:20px;font-weight:800;margin-bottom:6px}
.page-sub{font-size:12px;color:var(--grey);margin-bottom:20px}
.card{background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
.card-header{padding:14px 16px;border-bottom:1px solid var(--grey-lt);display:flex;align-items:center;justify-content:space-between}
.card-header h3{font-size:13px;font-weight:700}

/* Buttons */
.btn{padding:8px 16px;border:none;border-radius:7px;font-size:12px;font-weight:700;transition:.15s;display:inline-flex;align-items:center;gap:6px}
.btn-primary{background:var(--gold);color:var(--black)}
.btn-primary:hover{background:var(--gold-dk)}
.btn-secondary{background:var(--grey-lt);color:var(--black)}
.btn-secondary:hover{background:#e0e0e0}
.btn-danger{background:var(--red-lt);color:var(--red)}
.btn-danger:hover{background:#ffd6d6}
.btn-success{background:var(--green-lt);color:var(--green)}
.btn-sm{padding:5px 10px;font-size:11px}

/* Stats */
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
.stat-card{background:var(--white);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow)}
.stat-card .val{font-family:'Montserrat',sans-serif;font-size:28px;font-weight:800;color:var(--black)}
.stat-card .lbl{font-size:11px;color:var(--grey);margin-top:4px}

/* Table */
.data-table{width:100%;border-collapse:collapse}
.data-table th{background:var(--cream);padding:10px 13px;font-size:11px;font-weight:700;color:var(--grey);text-transform:uppercase;letter-spacing:.4px;text-align:left;border-bottom:1px solid var(--grey-lt)}
.data-table td{padding:11px 13px;font-size:12px;border-bottom:1px solid var(--grey-lt);vertical-align:middle}
.data-table tr:hover td{background:var(--cream)}
.data-table tr:last-child td{border-bottom:none}

/* Search */
.search-row{display:flex;gap:10px;margin-bottom:14px;align-items:center}
.search-input{padding:9px 13px;border:1.5px solid #E5E5E5;border-radius:var(--radius);font-size:13px;outline:none;width:280px;transition:.15s}
.search-input:focus{border-color:var(--gold)}
.filter-select{padding:9px 11px;border:1.5px solid #E5E5E5;border-radius:var(--radius);font-size:12px;outline:none;background:var(--white)}
.gs-pbtn{padding:6px 13px;border:1.5px solid #E5E5E5;border-radius:20px;font-size:12px;font-weight:600;background:var(--white);color:var(--grey);cursor:pointer;transition:.15s;white-space:nowrap}
.gs-pbtn:hover{border-color:var(--gold);color:var(--black)}
.gs-pbtn.active{background:var(--gold);border-color:var(--gold);color:var(--black)}

/* Badges */
.badge{display:inline-block;padding:3px 9px;border-radius:20px;font-size:10px;font-weight:700;white-space:nowrap}
.b-planifiee{background:#E3F2FD;color:#1565C0}
.b-en_cours{background:var(--orange-lt);color:var(--orange)}
.b-terminee{background:var(--green-lt);color:var(--green)}
.b-annulee{background:var(--grey-lt);color:var(--grey)}
.b-a_faire{background:var(--grey-lt);color:var(--grey)}
.b-distribue{background:var(--green-lt);color:var(--green)}
.b-ferme{background:var(--red-lt);color:var(--red)}
.b-refus{background:#F3E5F5;color:#7B1FA2}
.b-absent{background:var(--orange-lt);color:var(--orange)}

/* Modal */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:500;display:none;align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal-box{background:var(--white);border-radius:14px;width:560px;max-width:95vw;max-height:90vh;overflow-y:auto;box-shadow:0 8px 40px rgba(0,0,0,.2)}
.modal-header{padding:16px 20px;border-bottom:1px solid var(--grey-lt);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:var(--white);z-index:1}
.modal-header h3{font-size:15px;font-weight:800}
.modal-close{background:none;border:none;font-size:20px;color:var(--grey);line-height:1}
.modal-body{padding:20px}
.modal-footer{padding:14px 20px;border-top:1px solid var(--grey-lt);display:flex;justify-content:flex-end;gap:10px}

/* Form */
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.form-row.full{grid-template-columns:1fr}
.form-group{margin-bottom:12px}
.form-label{display:block;font-size:10px;font-weight:700;color:var(--grey);text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px}
.form-input{width:100%;padding:10px 12px;border:1.5px solid #E5E5E5;border-radius:8px;font-size:13px;outline:none;transition:.15s;background:var(--white);color:var(--black)}
.form-input:focus{border-color:var(--gold)}
textarea.form-input{resize:vertical;min-height:70px}

/* Dashboard */
.dash-grid{display:grid;grid-template-columns:2fr 1fr;gap:16px}
.tournee-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--grey-lt);cursor:pointer}
.tournee-row:last-child{border-bottom:none}
.tournee-row:hover{background:var(--cream);margin:0 -16px;padding:10px 16px}
.tr-icon{width:36px;height:36px;border-radius:8px;background:var(--gold-lt);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.tr-info{flex:1;min-width:0}
.tr-name{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tr-meta{font-size:11px;color:var(--grey);margin-top:2px}
.prog-mini{background:#E5E5E5;height:4px;border-radius:2px;margin-top:5px;overflow:hidden}
.prog-mini-fill{background:var(--gold);height:4px;border-radius:2px}
.rt-item{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--grey-lt);font-size:12px}
.rt-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.rt-nom{flex:1;font-weight:600}

/* Tournée detail */
#tournee-detail-view{display:none}
.detail-header{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.detail-header h2{font-size:18px;font-weight:800}
.stop-list-item{display:flex;align-items:center;gap:10px;padding:10px 13px;border-bottom:1px solid var(--grey-lt);transition:.15s}
.stop-list-item:hover{background:var(--cream)}
.stop-list-item.dragging{opacity:.35}
.stop-list-item.drag-over{border-top:2px solid var(--gold-dk)}
.stop-drag-handle{cursor:grab;color:var(--grey);font-size:14px;padding:0 2px;flex-shrink:0;user-select:none}
.stop-ord{width:26px;height:26px;border-radius:50%;background:var(--gold-lt);color:var(--gold-dk);font-family:'Montserrat',sans-serif;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.stop-info{flex:1;min-width:0}
.stop-nom{font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.stop-addr{font-size:10px;color:var(--grey);margin-top:1px}

/* Carte */
#map-container{flex:1;position:relative;min-height:0}
#map{width:100%;height:100%}
#map-toolbar2{padding:8px 14px;background:#fafafa;border-bottom:1px solid var(--grey-lt);display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:12px}
#map-toolbar2 input[type=number]{width:52px;padding:4px 6px;border:1.5px solid #ddd;border-radius:6px;font-size:12px;text-align:center}
.map-legend{display:flex;gap:10px;align-items:center;margin-left:auto;flex-wrap:wrap}
.map-leg-dot{display:inline-block;width:11px;height:11px;border-radius:50%;border:2px solid rgba(0,0,0,.15);flex-shrink:0;vertical-align:middle;margin-right:3px}
#map-alertes{flex-shrink:0;max-height:220px;overflow-y:auto;border-top:2px solid #f0f0f0;background:#fff}
#map-alertes-hdr{padding:8px 14px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;background:#FFF3E0;border-top:2px solid #E8A020;font-size:12px;font-weight:700;color:#B36000}
#map-alertes-hdr.ok{background:#E8F5E9;border-color:#27AE60;color:#1B5E20}
#map-alertes-body{display:none;padding:6px 14px 10px}
#map-alertes-body.open{display:block}
.map-alerte-item{display:flex;justify-content:space-between;align-items:center;padding:5px 0;border-bottom:1px solid #f5f5f5;font-size:12px}
.map-alerte-item:last-child{border-bottom:none}

/* Éditeur iframe */
#editeur-iframe{width:100%;flex:1;border:none;display:block}
.editeur-toolbar{background:var(--black);padding:8px 14px;display:flex;align-items:center;gap:8px;flex-shrink:0;border-bottom:2px solid var(--gold)}
.editeur-toolbar span{font-size:12px;color:rgba(255,255,255,.6)}
.editeur-toolbar a{color:var(--gold);font-size:12px;font-weight:600;text-decoration:underline}

/* Toast */
#toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:rgba(26,26,26,.92);color:var(--white);padding:10px 20px;border-radius:20px;font-size:12px;font-weight:600;z-index:1000;opacity:0;pointer-events:none;transition:opacity .25s;white-space:nowrap}
#toast.show{opacity:1}

/* Loader */
.loader{display:inline-block;width:14px;height:14px;border:2px solid rgba(0,0,0,.15);border-top-color:var(--gold-dk);border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* Live */
.live-badge{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--green);animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

/* Fiche lieu */
.fiche-stats-d{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:18px}
.fsd-tile{background:var(--cream);border-radius:8px;padding:12px;text-align:center}
.fsd-tile .sv{font-family:'Montserrat',sans-serif;font-size:22px;font-weight:800}
.fsd-tile .sl{font-size:10px;color:var(--grey);margin-top:2px}
.fiche-timeline-d{display:flex;flex-direction:column}
.ftd-item{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--grey-lt)}
.ftd-item:last-child{border-bottom:none}
.ftd-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0;margin-top:3px;border:2px solid white}
.ftd-content{flex:1;min-width:0}
.ftd-date{font-size:12px;font-weight:700;margin-bottom:3px;text-transform:capitalize}
.ftd-meta{font-size:11px;color:var(--grey);display:flex;gap:10px;flex-wrap:wrap;margin-top:3px}
.ftd-comment{font-size:12px;background:var(--cream);border-radius:6px;padding:6px 10px;margin-top:5px;color:var(--black)}
.ftd-photo{width:70px;height:70px;border-radius:6px;object-fit:cover;cursor:pointer;margin-top:6px;flex-shrink:0}
.photo-grid-d{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:16px}
.photo-grid-d img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:6px;cursor:pointer;display:block;transition:.15s}
.photo-grid-d img:hover{opacity:.8}
.photo-lb-d{position:fixed;inset:0;background:rgba(0,0,0,.93);z-index:1000;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px}
.photo-lb-d img{max-width:90vw;max-height:80vh;border-radius:8px;object-fit:contain}
.photo-lb-d-close{position:absolute;top:14px;right:16px;color:#fff;font-size:28px;cursor:pointer;line-height:1}

/* Lieux picker */
#lieux-picker{max-height:260px;overflow-y:auto;border:1.5px solid #E5E5E5;border-radius:8px;margin-top:6px}
.lieu-pick-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-bottom:1px solid var(--grey-lt);cursor:pointer;transition:.15s}
.lieu-pick-item:hover{background:var(--cream)}
.lieu-pick-item.selected{background:var(--gold-lt)}
.lieu-pick-item:last-child{border-bottom:none}
.lpi-check{width:18px;height:18px;border-radius:4px;border:2px solid #ddd;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:11px;transition:.15s}
.lieu-pick-item.selected .lpi-check{background:var(--gold);border-color:var(--gold)}
.lpi-name{font-size:12px;font-weight:600;flex:1}
.lpi-cat{font-size:10px;color:var(--grey)}
.lpi-search{width:100%;padding:9px 12px;border:none;border-bottom:1.5px solid var(--grey-lt);font-size:12px;outline:none}

/* Diag */
#diag-banner{background:#1A1A1A;color:#F5C21A;padding:12px 20px;font-size:13px;font-family:monospace;display:none;flex-direction:column;gap:6px;max-height:200px;overflow-y:auto;flex-shrink:0}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="login-screen">
  <div class="login-card">
    <div class="login-logo">
      <img src="logo_transparent.png" alt="Nougaterie du Pont d'Arc">
    </div>
    <div class="login-err" id="login-err"></div>
    <div class="login-field">
      <label>Email</label>
      <input type="email" id="login-email" placeholder="votre@email.com" autocomplete="email">
    </div>
    <div class="login-field">
      <label>Mot de passe</label>
      <input type="password" id="login-pwd" placeholder="••••••••" autocomplete="current-password">
    </div>
    <button class="btn-login" onclick="doLogin()">Se connecter</button>
  </div>
</div>

<!-- APP -->
<div id="app">

  <div id="app-header">
    <div class="hdr-logo"><span class="bee">🐝</span> Nougaterie</div>
    <div class="hdr-tabs">
      <button class="hdr-tab active" onclick="showSection('dashboard')" id="tab-dashboard">🏠 Dashboard</button>
      <button class="hdr-tab" onclick="showSection('stats')" id="tab-stats">📊 Statistiques</button>
      <button class="hdr-tab" onclick="showSection('tournees')" id="tab-tournees">🗺️ Tournées</button>
      <button class="hdr-tab" onclick="showSection('carte')" id="tab-carte">🗺 Carte</button>
      <button class="hdr-tab" onclick="showSection('editeur')" id="tab-editeur">✏️ Éditeur lieux</button>
      <button class="hdr-tab" onclick="showSection('distributeurs')" id="tab-distributeurs">👥 Distributeurs</button>
      <button class="hdr-tab" onclick="showSection('suivi')" id="tab-suivi">📡 Suivi live</button>
      <button class="hdr-tab" onclick="showSection('notes')" id="tab-notes">📝 Notes <span id="notes-badge" style="display:none;background:#E53935;color:#fff;border-radius:10px;padding:1px 6px;font-size:10px;font-weight:700;margin-left:4px">0</span></button>
    </div>
    <div class="hdr-spacer"></div>
    <div class="hdr-user">
      <span id="hdr-username">—</span>
      <button class="btn-logout" onclick="doLogout()">Déconnexion</button>
    </div>
  </div>

  <div id="app-body">

    <!-- DASHBOARD -->
    <div class="section active" id="section-dashboard">
      <div class="page-title">Tableau de bord</div>
      <div class="page-sub">Vue d'ensemble de la distribution</div>
      <div class="stats-row" id="stats-row">
        <div class="stat-card"><div class="val" id="st-lieux">—</div><div class="lbl">Lieux actifs</div></div>
        <div class="stat-card"><div class="val" id="st-tournees">—</div><div class="lbl">Tournées</div></div>
        <div class="stat-card"><div class="val" id="st-distribues">—</div><div class="lbl">Points validés</div></div>
        <div class="stat-card"><div class="val" id="st-flyers">—</div><div class="lbl">Flyers distribués</div></div>
      </div>
      <div class="dash-grid">
        <div class="card">
          <div class="card-header">
            <h3>Tournées récentes</h3>
            <button class="btn btn-primary btn-sm" onclick="showSection('tournees')">Voir tout</button>
          </div>
          <div style="padding:4px 16px" id="dash-tournees-list">
            <div style="padding:20px;text-align:center;color:var(--grey);font-size:13px">Chargement…</div>
          </div>
        </div>
        <div class="card">
          <div class="card-header">
            <h3>Activité récente <span class="live-badge" style="margin-left:6px"></span></h3>
          </div>
          <div style="padding:4px 16px" id="dash-activity">
            <div style="padding:20px;text-align:center;color:var(--grey);font-size:13px">En attente…</div>
          </div>
        </div>
      </div>
    </div>

    <!-- STATISTIQUES -->
    <div class="section" id="section-stats">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:4px">
        <div>
          <div class="page-title">Statistiques des visites</div>
          <div class="page-sub">Historique complet des points de distribution</div>
