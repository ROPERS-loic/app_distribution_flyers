    </div>`;
  }).join('');
  document.getElementById('picker-count').textContent=ST.pickerSelected.size+' lieu'+(ST.pickerSelected.size>1?'x':'')+' sélectionné'+(ST.pickerSelected.size>1?'s':'');
}
